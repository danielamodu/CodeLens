  "nodes": {
    "var_1e4d3abcaade": {
      "type": "variant",
      "label": "CodeLens Onboarding — Lenses",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n\n:root {\n    --ink: #241C2E;\n    --ink-soft: #3A3040;\n    --paper: #FFFFFF;\n    --cream: #FAF7F2;\n    --line: #E7E2DA;\n    --muted: #6F6A72;\n\n    --coral: #FF6B4A;\n    --gold: #F4B740;\n    --lav: #CDB8F7;\n    --sage: #8FBF6B;\n    --sky: #AEDDE4;\n    --pink: #F25C9A;\n    --orange: #F2884B;\n\n    --radius-lg: 32px;\n    --radius-md: 20px;\n    --radius-sm: 12px;\n    \n    --font-serif: Georgia, \"Times New Roman\", serif;\n    --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif;\n}\n\nbody {\n    font-family: var(--font-sans);\n    background-color: var(--cream);\n    color: var(--ink);\n    min-height: 100vh;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow-x: clip;\n}\n\n/* ============ ONBOARDING FRAME ============ */\n.onboarding-container {\n    box-sizing: border-box;\n    width: 100%;\n    max-width: 1180px;\n    background: var(--paper);\n    border-radius: var(--radius-lg);\n    box-shadow: 0 40px 100px -20px rgba(36, 28, 46, 0.15), 0 10px 30px rgba(36, 28, 46, 0.05);\n    display: grid;\n    grid-template-columns: 1.1fr 0.9fr;\n    overflow: hidden;\n    min-height: 720px;\n    margin: 40px;\n    position: relative;\n}\n\n@media (max-width: 1024px) {\n    .onboarding-container {\n        grid-template-columns: 1fr;\n        max-width: 600px;\n    }\n    .collage-section {\n        display: none;\n    }\n}\n\n/* ---------- LEFT CONTENT ---------- */\n.content-section {\n    box-sizing: border-box;\n    padding: 3.5rem 4.5rem;\n    display: flex;\n    flex-direction: column;\n    height: 100%;\n}\n\n.header-meta {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 4rem;\n}\n\n.logo {\n    display: flex;\n    align-items: center;\n    gap: 0.75rem;\n    font-weight: 700;\n    font-size: 1.25rem;\n    letter-spacing: -0.02em;\n}\n\n.logo-mark {\n    width: 32px;\n    height: 32px;\n    border: 2px solid var(--ink);\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    position: relative;\n}\n\n.logo-dot {\n    width: 6px;\n    height: 6px;\n    background: var(--coral);\n    border-radius: 50%;\n}\n\n.step-indicator {\n    font-size: 0.85rem;\n    font-weight: 600;\n    color: var(--muted);\n    letter-spacing: 0.05em;\n    display: flex;\n    align-items: center;\n    gap: 0.5rem;\n}\n\n.step-bar {\n    width: 40px;\n    height: 3px;\n    background: var(--line);\n    border-radius: 99px;\n    position: relative;\n}\n\n.step-bar-active {\n    position: absolute;\n    left: 0;\n    top: 0;\n    height: 100%;\n    width: 33.33%;\n    background: var(--ink);\n    border-radius: 99px;\n}\n\n.main-heading {\n    font-family: var(--font-serif);\n    font-size: 3rem;\n    line-height: 1.1;\n    margin-bottom: 1.25rem;\n}\n\n.sub-text {\n    font-size: 1.1rem;\n    line-height: 1.6;\n    color: var(--muted);\n    margin-bottom: 2.5rem;\n    max-width: 420px;\n}\n\n/* ---------- MODE SELECTOR ---------- */\n.mode-grid {\n    display: flex;\n    flex-direction: column;\n    gap: 1.25rem;\n    margin-bottom: 3rem;\n}\n\n.mode-card {\n    box-sizing: border-box;\n    position: relative;\n    padding: 1.5rem 1.75rem;\n    border: 2px solid var(--line);\n    border-radius: var(--radius-md);\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    gap: 1.5rem;\n    /* Removed transform from transition to avoid conflict with GSAP */\n    transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;\n}\n\n.mode-card:hover {\n    border-color: var(--ink);\n    background: var(--cream);\n}\n\n.mode-card.active {\n    border-color: var(--ink);\n    background: var(--paper);\n    box-shadow: 0 12px 30px -10px rgba(36, 28, 46, 0.12);\n}\n\n.mode-icon {\n    width: 56px;\n    height: 56px;\n    border-radius: 14px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n}\n\n.mode-icon.algo { background: var(--gold); }\n.mode-icon.security { background: var(--coral); }\n\n.mode-info h3 {\n    font-size: 1.15rem;\n    font-weight: 700;\n    margin-bottom: 0.25rem;\n}\n\n.mode-info p {\n    font-size: 0.9rem;\n    color: var(--muted);\n    line-height: 1.4;\n}\n\n.radio-circle {\n    width: 20px;\n    height: 20px;\n    border: 2px solid var(--line);\n    border-radius: 50%;\n    margin-left: auto;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    transition: all 0.2s ease;\n}\n\n.mode-card.active .radio-circle {\n    border-color: var(--ink);\n}\n\n.mode-card.active .radio-circle::after {\n    content: '';\n    width: 10px;\n    height: 10px;\n    background: var(--ink);\n    border-radius: 50%;\n}\n\n/* ---------- ACTIONS ---------- */\n.action-row {\n    margin-top: auto;\n    display: flex;\n    align-items: center;\n    gap: 2rem;\n}\n\n.primary-btn {\n    background: var(--ink);\n    color: var(--paper);\n    padding: 1rem 2.5rem;\n    border-radius: 999px;\n    font-weight: 700;\n    font-size: 0.95rem;\n    letter-spacing: 0.05em;\n    cursor: pointer;\n    border: none;\n    transition: all 0.2s ease;\n}\n\n.primary-btn:hover {\n    background: var(--ink-soft);\n    transform: translateY(-2px);\n    box-shadow: 0 10px 20px -5px rgba(36, 28, 46, 0.3);\n}\n\n.text-btn {\n    color: var(--muted);\n    font-weight: 600;\n    font-size: 0.95rem;\n    cursor: pointer;\n    text-decoration: none;\n    transition: color 0.2s ease;\n}\n\n.text-btn:hover {\n    color: var(--ink);\n}\n\n/* ---------- RIGHT COLLAGE ---------- */\n.collage-section {\n    background: var(--paper);\n    position: relative;\n    border-left: 1px solid var(--line);\n    overflow: hidden;\n}\n\n.mosaic-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    grid-template-rows: repeat(4, 1fr);\n    height: 100%;\n}\n\n.tile {\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 2rem;\n    overflow: hidden;\n}\n\n.tile-copy {\n    font-family: var(--font-serif);\n    font-weight: 700;\n    font-size: 1.5rem;\n    line-height: 1.2;\n    z-index: 2;\n}\n\n.tile-icon-box {\n    width: 80px;\n    height: 80px;\n    background: var(--paper);\n    border-radius: var(--radius-sm);\n    box-shadow: 0 10px 25px rgba(36, 28, 46, 0.1);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    z-index: 2;\n    transform: rotate(6deg);\n}\n\n.icon-svg {\n    width: 28px;\n    height: 28px;\n    color: white;\n}\n\n.collage-bracket {\n    font-size: 2.25rem;\n    font-weight: 700;\n    color: var(--ink);\n}\n\n.collage-shield-box {\n    width: 64px;\n    height: 64px;\n    background: var(--ink);\n    border-radius: 16px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    transform: rotate(-6deg);\n    box-shadow: 0 15px 30px rgba(0,0,0,0.2);\n}\n\n.collage-timer-box {\n    width: 80px;\n    height: 80px;\n    background: var(--paper);\n    border-radius: 50%;\n    border: 4px solid var(--ink);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    box-shadow: 0 10px 25px rgba(0,0,0,0.1);\n}\n\n.collage-timer-icon {\n    width: 40px;\n    height: 40px;\n    color: var(--ink);\n}\n\n.tile-lav { background: var(--lav); }\n.tile-sky { background: var(--sky); }\n.tile-sage { background: var(--sage); }\n.tile-coral { background: var(--coral); color: white; }\n.tile-gold { background: var(--gold); }\n.tile-paper { background: var(--paper); }\n.tile-cream { background: var(--cream); }\n\n.ribbon-svg {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    z-index: 5;\n    pointer-events: none;\n}\n\n.ribbon-path {\n    fill: none;\n    stroke: var(--ink);\n    stroke-width: 40;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n    opacity: 0.95;\n}\n</style>\n<div class=\"onboarding-container\" data-kid=\"1\" data-name=\"onboarding container\" id=\"main-frame\">\n    <!-- Left Panel -->\n    <div class=\"content-section\" data-kid=\"1-1\" data-name=\"left content section\">\n        <header class=\"header-meta\" data-kid=\"1-1-1\" data-name=\"header metadata bar\">\n            <div class=\"logo\" data-kid=\"1-1-1-1\" data-name=\"logo container\">\n                <div class=\"logo-mark\" data-kid=\"1-1-1-1-1\" data-name=\"logo circular mark\">\n                    <div class=\"logo-dot\" data-kid=\"1-1-1-1-1-1\" data-name=\"logo dot\">\n                    </div>\n                </div>\n                CodeLens\n            </div>\n            <div class=\"step-indicator\" data-kid=\"1-1-1-2\" data-name=\"onboarding step indicator\">\n                <span data-kid=\"1-1-1-2-1\" data-name=\"current step index text\">\n                    01\n                </span>\n                <div class=\"step-bar\" data-kid=\"1-1-1-2-2\" data-name=\"progress bar track\">\n                    <div class=\"step-bar-active\" data-kid=\"1-1-1-2-2-1\" data-name=\"active progress bar\">\n                    </div>\n                </div>\n                <span data-kid=\"1-1-1-2-3\" data-name=\"total steps index text\">\n                    03\n                </span>\n            </div>\n        </header>\n        <div class=\"flex-grow\" data-kid=\"1-1-2\" data-name=\"main content area\">\n            <h1 class=\"main-heading reveal-up\" data-kid=\"1-1-2-1\" data-name=\"main heading\">\n                Choose your lens.\n            </h1>\n            <p class=\"sub-text reveal-up\" data-kid=\"1-1-2-2\" data-name=\"subtext description\">\n                CodeLens monitors both velocity and integrity. Pick a primary focus to tailor your first analysis.\n            </p>\n            <div class=\"mode-grid\" data-kid=\"1-1-2-3\" data-name=\"mode selection grid\">\n                <div class=\"mode-card active reveal-up\" data-kid=\"1-1-2-3-1\" data-name=\"active mode selection card\" onclick=\"selectMode(this)\">\n                    <div class=\"mode-icon algo\" data-kid=\"1-1-2-3-1-1\" data-name=\"mode icon container\">\n                        <svg class=\"icon-svg\" data-kid=\"1-1-2-3-1-1-1\" data-name=\"algorithm icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                            <path d=\"M13 10V3L4 14h7v7l9-11h-7z\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\">\n                            </path>\n                        </svg>\n                    </div>\n                    <div class=\"mode-info\" data-kid=\"1-1-2-3-1-2\" data-name=\"mode info text group\">\n                        <h3 data-kid=\"1-1-2-3-1-2-1\" data-name=\"mode title\">\n                            Algo diagnosis\n                        </h3>\n                        <p data-kid=\"1-1-2-3-1-2-2\" data-name=\"mode description\">\n                            Complexity, bottlenecks, and nested loop detection.\n                        </p>\n                    </div>\n                    <div class=\"radio-circle\" data-kid=\"1-1-2-3-1-3\" data-name=\"radio button circle\">\n                    </div>\n                </div>\n                <div class=\"mode-card reveal-up\" data-kid=\"1-1-2-3-2\" data-name=\"inactive mode selection card\" onclick=\"selectMode(this)\">\n                    <div class=\"mode-icon security\" data-kid=\"1-1-2-3-2-1\" data-name=\"mode icon container\">\n                        <svg class=\"icon-svg\" data-kid=\"1-1-2-3-2-1-1\" data-name=\"security icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                            <path d=\"M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\">\n                            </path>\n                        </svg>\n                    </div>\n                    <div class=\"mode-info\" data-kid=\"1-1-2-3-2-2\" data-name=\"mode info text group\">\n                        <h3 data-kid=\"1-1-2-3-2-2-1\" data-name=\"mode title\">\n                            Security scan\n                        </h3>\n                        <p data-kid=\"1-1-2-3-2-2-2\" data-name=\"mode description\">\n                            Secrets leakage, unsafe inputs, and risky dependencies.\n                        </p>\n                    </div>\n                    <div class=\"radio-circle\" data-kid=\"1-1-2-3-2-3\" data-name=\"radio button circle\">\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"action-row reveal-up\" data-kid=\"1-1-3\" data-name=\"action button row\">\n            <button class=\"primary-btn\" data-kid=\"1-1-3-1\" data-name=\"primary call-to-action button\">\n                NEXT STEP\n            </button>\n            <a class=\"text-btn\" data-kid=\"1-1-3-2\" data-name=\"skip action link\" href=\"#\">\n                Skip for now\n            </a>\n        </div>\n    </div>\n    <!-- Right Panel: Collage -->\n    <div class=\"collage-section\" data-kid=\"1-2\" data-name=\"right collage section\">\n        <div class=\"mosaic-grid\" data-kid=\"1-2-1\" data-name=\"mosaic collage grid\">\n            <!-- Row 1 -->\n            <div class=\"tile tile-sky\" data-kid=\"1-2-1-1\" data-name=\"decorative collage tile\">\n                <div class=\"tile-icon-box\" data-kid=\"1-2-1-1-1\" data-name=\"collage icon container\">\n                    <span class=\"collage-bracket\" data-kid=\"1-2-1-1-1-1\" data-name=\"bracket icon text\">\n                        { }\n                    </span>\n                </div>\n            </div>\n            <div class=\"tile tile-coral\" data-kid=\"1-2-1-2\" data-name=\"decorative collage tile with text\">\n                <div class=\"tile-copy\" data-kid=\"1-2-1-2-1\" data-name=\"collage marketing text\">\n                    Efficiency matters.\n                </div>\n            </div>\n            <div class=\"tile tile-paper\" data-kid=\"1-2-1-3\" data-name=\"empty decorative tile\">\n            </div>\n            <!-- Row 2 -->\n            <div class=\"tile tile-paper\" data-kid=\"1-2-1-4\" data-name=\"empty decorative tile\">\n            </div>\n            <div class=\"tile tile-sage\" data-kid=\"1-2-1-5\" data-name=\"decorative collage tile\">\n                <div class=\"collage-timer-box\" data-kid=\"1-2-1-5-1\" data-name=\"timer icon container\">\n                    <svg class=\"collage-timer-icon\" data-kid=\"1-2-1-5-1-1\" data-name=\"timer icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                        <path d=\"M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\">\n                        </path>\n                    </svg>\n                </div>\n            </div>\n            <div class=\"tile tile-lav\" data-kid=\"1-2-1-6\" data-name=\"empty decorative tile\">\n            </div>\n            <!-- Row 3 -->\n            <div class=\"tile tile-gold\" data-kid=\"1-2-1-7\" data-name=\"decorative collage tile with text\">\n                <div class=\"tile-copy text-[var(--ink)]\" data-kid=\"1-2-1-7-1\" data-name=\"collage marketing text\">\n                    Scale with\n                    <br data-kid=\"1-2-1-7-1-1\" data-name=\"line break\"/>\n                    safety.\n                </div>\n            </div>\n            <div class=\"tile tile-cream\" data-kid=\"1-2-1-8\" data-name=\"empty decorative tile\">\n            </div>\n            <div class=\"tile tile-coral\" data-kid=\"1-2-1-9\" data-name=\"empty decorative tile\">\n            </div>\n            <!-- Row 4 -->\n            <div class=\"tile tile-sky\" data-kid=\"1-2-1-10\" data-name=\"empty decorative tile\">\n            </div>\n            <div class=\"tile tile-lav\" data-kid=\"1-2-1-11\" data-name=\"decorative collage tile\">\n                <div class=\"collage-shield-box\" data-kid=\"1-2-1-11-1\" data-name=\"shield icon container\">\n                    <svg class=\"icon-svg\" data-kid=\"1-2-1-11-1-1\" data-name=\"shield icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                        <path d=\"M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\">\n                        </path>\n                    </svg>\n                </div>\n            </div>\n            <div class=\"tile tile-paper\" data-kid=\"1-2-1-12\" data-name=\"empty decorative tile\">\n            </div>\n        </div>\n        <!-- Ribbon -->\n        <svg class=\"ribbon-svg\" data-dynamic=\"true\" data-kid=\"1-2-2\" data-name=\"ribbon decorative vector graphic\" data-reason=\"path stroke animation drawn by script on load\" preserveaspectratio=\"none\" viewbox=\"0 0 472 720\">\n            <path class=\"ribbon-path\" d=\"M472,60 C320,150 400,280 250,360 C100,440 180,580 0,660\" id=\"ribbon-path\">\n            </path>\n        </svg>\n    </div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    function selectMode(element) {\n        document.querySelectorAll('.mode-card').forEach(card => card.classList.remove('active'));\n        element.classList.add('active');\n    }\n\n    window.addEventListener('DOMContentLoaded', () => {\n        const tl = gsap.timeline({ defaults: { ease: \"power4.out\", duration: 1.2 }});\n\n        // Ribbon drawing simulation\n        const path = document.querySelector('#ribbon-path');\n        const length = path.getTotalLength();\n        \n        gsap.set(path, {\n            strokeDasharray: length,\n            strokeDashoffset: length\n        });\n\n        tl.to(path, {\n            strokeDashoffset: 0,\n            duration: 2.5,\n            ease: \"power2.inOut\"\n        });\n\n        // Use gsap.set for initial hidden state instead of CSS\n        gsap.set('.reveal-up', { opacity: 0, y: 30 });\n\n        tl.to('.reveal-up', {\n            opacity: 1,\n            y: 0,\n            stagger: 0.15,\n            duration: 1.2,\n            ease: \"power3.out\"\n        }, \"-=2\");\n\n        // Subtle tile animations\n        gsap.from('.tile', {\n            scale: 0.9,\n            opacity: 0,\n            stagger: {\n                amount: 0.6,\n                grid: [4, 3],\n                from: \"center\"\n            },\n            duration: 0.8,\n            ease: \"back.out(1.7)\"\n        }, \"-=1.2\");\n    });\n</script>\n",
      "comments": [],
      "created": "2026-08-02T17:20:22.727639+00:00",
