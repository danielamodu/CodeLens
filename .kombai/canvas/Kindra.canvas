    "var_9c84ede51f7a": {
      "type": "variant",
      "label": "CodeLens App — Error",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<div class=\"app-container min-h-screen bg-[#FAF7F2] font-sans text-[#241C2E] overflow-x-clip relative\" data-kid=\"1\" data-name=\"app layout container\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Lora:wght@600;700&display=swap');\n        \n        :root {\n            --ink: #241C2E;\n            --paper: #FFFFFF;\n            --cream: #FAF7F2;\n            --line: #E7E2DA;\n            --muted: #6F6A72;\n            --coral: #FF6B4A;\n            --gold: #F4B740;\n            --lav: #CDB8F7;\n            --sage: #8FBF6B;\n            --sky: #AEDDE4;\n            --pink: #F25C9A;\n            --orange: #F2884B;\n        }\n\n        .font-serif { font-family: 'Lora', 'Georgia', serif; }\n        \n        .pill-shadow { box-shadow: 0 2px 8px rgba(36, 28, 46, 0.04); }\n        .card-shadow { box-shadow: 0 20px 40px -10px rgba(36, 28, 46, 0.08); }\n        .editor-shadow { box-shadow: inset 0 2px 10px rgba(36, 28, 46, 0.02); }\n\n        .clip-diamond {\n            clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);\n        }\n\n        /* Custom scrollbar */\n        .custom-scroll::-webkit-scrollbar { width: 4px; }\n        .custom-scroll::-webkit-scrollbar-track { background: transparent; }\n        .custom-scroll::-webkit-scrollbar-thumb { background: var(--line); border-radius: 10px; }\n\n        .ribbon-container {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n            z-index: 0;\n            overflow: clip;\n        }\n\n        /* Animation specific - no opacity transition on GSAP targets */\n        .animate-entrance { }\n        .history-card { }\n    </style>\n    <!-- Decorative Ribbon -->\n    <div class=\"ribbon-container\" data-kid=\"1-1\" data-name=\"background decoration ribbon container\">\n        <svg class=\"opacity-25\" data-dynamic=\"true\" data-kid=\"1-1-1\" data-name=\"decorative ribbon svg graphic\" data-reason=\"path attribute d animated by GSAP\" fill=\"none\" height=\"900\" id=\"main-ribbon\" viewbox=\"0 0 1440 900\" width=\"1440\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M1440 50C1200 150 1300 300 1100 450C900 600 950 750 750 850C550 950 600 1050 400 1100\" stroke=\"var(--ink)\" stroke-linecap=\"round\" stroke-width=\"40\">\n            </path>\n            <path d=\"M-100 200C100 350 50 500 250 650C450 800 400 950 600 1100\" opacity=\"0.3\" stroke=\"var(--ink)\" stroke-linecap=\"round\" stroke-width=\"20\">\n            </path>\n        </svg>\n    </div>\n    <div class=\"relative z-10 max-w-[1440px] mx-auto min-h-screen flex flex-col\" data-kid=\"1-2\" data-name=\"page content wrapper\">\n        <!-- Header -->\n        <header class=\"h-20 flex items-center justify-between px-10 border-b border-[var(--line)] bg-white/80 backdrop-blur-sm sticky top-0 z-50\" data-kid=\"1-2-1\" data-name=\"main header section\">\n            <div class=\"flex items-center gap-4\" data-kid=\"1-2-1-1\" data-name=\"brand identity container\">\n                <div class=\"w-9 h-9 rounded-full border-2 border-[var(--ink)] flex items-center justify-center p-1.5\" data-kid=\"1-2-1-1-1\" data-name=\"brand logo icon wrapper\">\n                    <div class=\"w-full h-full bg-[var(--coral)] clip-diamond\" data-kid=\"1-2-1-1-1-1\" data-name=\"brand logo diamond shape\">\n                    </div>\n                </div>\n                <h1 class=\"text-xl font-bold tracking-tight\" data-kid=\"1-2-1-1-2\" data-name=\"brand name text\">\n                    CodeLens\n                </h1>\n            </div>\n            <div class=\"flex items-center gap-8\" data-kid=\"1-2-1-2\" data-name=\"header navigation and user tools container\">\n                <nav class=\"flex items-center gap-6\" data-kid=\"1-2-1-2-1\" data-name=\"main navigation links\">\n                    <a class=\"text-sm font-bold text-[var(--muted)] hover:text-[var(--ink)]\" data-kid=\"1-2-1-2-1-1\" data-name=\"navigation link practice\" href=\"#\">\n                        Practice\n                    </a>\n                    <a class=\"text-sm font-bold text-[var(--muted)] hover:text-[var(--ink)]\" data-kid=\"1-2-1-2-1-2\" data-name=\"navigation link snippets\" href=\"#\">\n                        Snippets\n                    </a>\n                    <div class=\"w-1 h-1 rounded-full bg-[var(--line)]\" data-kid=\"1-2-1-2-1-3\" data-name=\"navigation separator dot\">\n                    </div>\n                    <a class=\"text-sm font-bold text-[var(--muted)] hover:text-[var(--ink)]\" data-kid=\"1-2-1-2-1-4\" data-name=\"navigation link docs\" href=\"#\">\n                        Docs\n                    </a>\n                </nav>\n                <div class=\"flex items-center gap-3 bg-white rounded-full py-1.5 pl-1.5 pr-4 border border-[var(--line)] pill-shadow\" data-kid=\"1-2-1-2-2\" data-name=\"user account pill\">\n                    <img alt=\"Maya Chen\" class=\"w-8 h-8 rounded-full object-cover border border-[var(--line)]\" data-kid=\"1-2-1-2-2-1\" data-name=\"user profile image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/100?u=maya\"/>\n                    <div class=\"flex flex-col\" data-kid=\"1-2-1-2-2-2\" data-name=\"user menu details container\">\n                        <span class=\"text-sm font-semibold leading-none\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"user display name\">\n                            Maya Chen\n                        </span>\n                        <button class=\"text-[9px] text-[var(--muted)] hover:text-[var(--ink)] text-left uppercase tracking-widest font-bold\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"user sign out button\">\n                            Sign Out\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </header>\n        <div class=\"flex-1 flex gap-0\" data-kid=\"1-2-2\" data-name=\"main workspace layout\">\n            <!-- Left History Sidebar -->\n            <aside class=\"w-72 border-r border-[var(--line)] bg-white/40 flex flex-col p-8 gap-8 overflow-y-auto custom-scroll\" data-kid=\"1-2-2-1\" data-name=\"recent history sidebar\">\n                <div class=\"flex items-center justify-between\" data-kid=\"1-2-2-1-1\" data-name=\"sidebar header container\">\n                    <h2 class=\"font-serif text-xl\" data-kid=\"1-2-2-1-1-1\" data-name=\"sidebar title\">\n                        Recent\n                    </h2>\n                    <button class=\"text-[10px] font-bold text-[var(--muted)] hover:text-[var(--ink)] uppercase tracking-wider\" data-kid=\"1-2-2-1-1-2\" data-name=\"sidebar clear button\">\n                        Clear\n                    </button>\n                </div>\n                <div class=\"flex flex-col gap-4\" data-kid=\"1-2-2-1-2\" data-name=\"history list container\" id=\"history-list\">\n                    <div class=\"history-card p-4 bg-white border border-[var(--line)] rounded-2xl cursor-pointer hover:border-[var(--ink)] transition-colors group active:scale-95\" data-kid=\"1-2-2-1-2-1\" data-name=\"history card 1\">\n                        <div class=\"flex justify-between items-start mb-1\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"history card header\">\n                            <code class=\"text-[10px] text-[var(--muted)] font-mono\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"history filename code\">\n                                auth.js\n                            </code>\n                            <span class=\"w-1.5 h-1.5 rounded-full bg-[var(--sage)]\" data-kid=\"1-2-2-1-2-1-1-2\" data-name=\"history status indicator 1\">\n                            </span>\n                        </div>\n                        <p class=\"text-sm font-semibold mb-2\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"history card title 1\">\n                            JWT Validation Scan\n                        </p>\n                        <div class=\"flex gap-2\" data-kid=\"1-2-2-1-2-1-3\" data-name=\"history tag list 1\">\n                            <span class=\"text-[9px] uppercase font-bold text-[var(--sage)]\" data-kid=\"1-2-2-1-2-1-3-1\" data-name=\"history tag 1\">\n                                Optimized\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"history-card p-4 bg-white border border-[var(--line)] rounded-2xl cursor-pointer border-l-4 border-l-[var(--coral)] hover:border-[var(--ink)] transition-colors active:scale-95\" data-kid=\"1-2-2-1-2-2\" data-name=\"history card 2\">\n                        <div class=\"flex justify-between items-start mb-1\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"history card header 2\">\n                            <code class=\"text-[10px] text-[var(--muted)] font-mono\" data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"history filename code 2\">\n                                payments.py\n                            </code>\n                            <span class=\"w-1.5 h-1.5 rounded-full bg-[var(--coral)]\" data-kid=\"1-2-2-1-2-2-1-2\" data-name=\"history status indicator 2\">\n                            </span>\n                        </div>\n                        <p class=\"text-sm font-semibold mb-2\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"history card title 2\">\n                            Stripe Integration\n                        </p>\n                        <div class=\"flex gap-2\" data-kid=\"1-2-2-1-2-2-3\" data-name=\"history tag list 2\">\n                            <span class=\"text-[9px] uppercase font-bold text-[var(--coral)]\" data-kid=\"1-2-2-1-2-2-3-1\" data-name=\"history tag 2\">\n                                Critical Vulnerability\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"history-card p-4 bg-white border border-[var(--line)] rounded-2xl cursor-pointer hover:border-[var(--ink)] transition-colors active:scale-95\" data-kid=\"1-2-2-1-2-3\" data-name=\"history card 3\">\n                        <div class=\"flex justify-between items-start mb-1\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"history card header 3\">\n                            <code class=\"text-[10px] text-[var(--muted)] font-mono\" data-kid=\"1-2-2-1-2-3-1-1\" data-name=\"history filename code 3\">\n                                user_service.go\n                            </code>\n                            <span class=\"w-1.5 h-1.5 rounded-full bg-[var(--lav)]\" data-kid=\"1-2-2-1-2-3-1-2\" data-name=\"history status indicator 3\">\n                            </span>\n                        </div>\n                        <p class=\"text-sm font-semibold mb-2\" data-kid=\"1-2-2-1-2-3-2\" data-name=\"history card title 3\">\n                            Query Optimization\n                        </p>\n                        <div class=\"flex gap-2\" data-kid=\"1-2-2-1-2-3-3\" data-name=\"history tag list 3\">\n                            <span class=\"text-[9px] uppercase font-bold text-[var(--muted)]\" data-kid=\"1-2-2-1-2-3-3-1\" data-name=\"history tag 3\">\n                                3 hours ago\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"history-card p-4 bg-white border border-[var(--line)] rounded-2xl cursor-pointer hover:border-[var(--ink)] transition-colors active:scale-95 opacity-60\" data-kid=\"1-2-2-1-2-4\" data-name=\"history card 4\">\n                        <div class=\"flex justify-between items-start mb-1\" data-kid=\"1-2-2-1-2-4-1\" data-name=\"history card header 4\">\n                            <code class=\"text-[10px] text-[var(--muted)] font-mono\" data-kid=\"1-2-2-1-2-4-1-1\" data-name=\"history filename code 4\">\n                                index.html\n                            </code>\n                        </div>\n                        <p class=\"text-sm font-semibold mb-2\" data-kid=\"1-2-2-1-2-4-2\" data-name=\"history card title 4\">\n                            Layout Refactor\n                        </p>\n                        <div class=\"flex gap-2\" data-kid=\"1-2-2-1-2-4-3\" data-name=\"history tag list 4\">\n                            <span class=\"text-[9px] uppercase font-bold text-[var(--muted)]\" data-kid=\"1-2-2-1-2-4-3-1\" data-name=\"history tag 4\">\n                                Yesterday\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </aside>\n            <!-- Workspace -->\n            <main class=\"flex-1 flex flex-col p-10 gap-8 overflow-y-auto custom-scroll\" data-kid=\"1-2-2-2\" data-name=\"main workspace area\">\n                <!-- Controls -->\n                <section class=\"flex flex-col gap-6\" data-kid=\"1-2-2-2-1\" data-name=\"analysis controls section\">\n                    <div class=\"flex gap-4\" data-kid=\"1-2-2-2-1-1\" data-name=\"github input container\">\n                        <div class=\"flex-1 relative\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"github url input field wrapper\">\n                            <input class=\"w-full h-16 bg-white rounded-2xl border border-[var(--line)] pl-6 pr-32 text-sm font-medium focus:outline-hidden focus:border-[var(--ink)] focus:ring-1 focus:ring-[var(--ink)] transition-all card-shadow\" data-kid=\"1-2-2-2-1-1-1-1\" data-name=\"github url input field\" placeholder=\"Enter GitHub URL...\" type=\"text\" value=\"https://github.com/maya-dev/secure-api/blob/main/src/auth.js\"/>\n                            <div class=\"absolute right-4 top-1/2 -translate-y-1/2 flex items-center gap-2\" data-kid=\"1-2-2-2-1-1-1-2\" data-name=\"github branch indicator container\">\n                                <span class=\"px-2 py-0.5 bg-[var(--sky)] text-[var(--sky-ink)] text-[9px] font-bold rounded uppercase\" data-kid=\"1-2-2-2-1-1-1-2-1\" data-name=\"branch name label\">\n                                    Main Branch\n                                </span>\n                            </div>\n                        </div>\n                        <button class=\"h-16 px-10 bg-[var(--ink)] text-white rounded-2xl text-sm font-bold tracking-widest hover:bg-[#3a3040] transition-all hover:-translate-y-0.5 active:translate-y-0\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"analyze button\">\n                            ANALYZE\n                        </button>\n                    </div>\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-2-2-2-1-2\" data-name=\"analysis options container\">\n                        <div class=\"flex bg-[var(--line)]/30 p-1.5 rounded-xl gap-1\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"analysis mode toggle\">\n                            <button class=\"px-6 py-2.5 rounded-lg text-xs font-bold transition-all bg-white shadow-sm ring-1 ring-[var(--line)]/10\" data-kid=\"1-2-2-2-1-2-1-1\" data-name=\"algorithmic mode button\">\n                                ALGORITHMIC\n                            </button>\n                            <button class=\"px-6 py-2.5 rounded-lg text-xs font-bold transition-all text-[var(--muted)] hover:text-[var(--ink)]\" data-kid=\"1-2-2-2-1-2-1-2\" data-name=\"security mode button\">\n                                SECURITY\n                            </button>\n                        </div>\n                        <div class=\"flex items-center gap-4 bg-white px-5 py-2.5 rounded-xl border border-[var(--line)] pill-shadow\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"deep scan toggle container\">\n                            <div class=\"flex flex-col items-end\" data-kid=\"1-2-2-2-1-2-2-1\" data-name=\"deep scan info label\">\n                                <span class=\"text-[10px] font-bold text-[var(--ink)] leading-none\" data-kid=\"1-2-2-2-1-2-2-1-1\" data-name=\"deep scan title\">\n                                    Deep Scan\n                                </span>\n                                <span class=\"text-[8px] text-[var(--muted)] font-bold uppercase tracking-tighter\" data-kid=\"1-2-2-2-1-2-2-1-2\" data-name=\"deep scan provider label\">\n                                    Powered by CodeLens AI\n                                </span>\n                            </div>\n                            <label class=\"relative inline-flex items-center cursor-pointer\" data-kid=\"1-2-2-2-1-2-2-2\" data-name=\"deep scan toggle input wrapper\">\n                                <input checked=\"\" class=\"sr-only peer\" data-kid=\"1-2-2-2-1-2-2-2-1\" data-name=\"deep scan checkbox\" type=\"checkbox\"/>\n                                <div class=\"w-10 h-5 bg-[var(--line)] peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-[var(--sage)]\" data-kid=\"1-2-2-2-1-2-2-2-2\" data-name=\"deep scan toggle switch\">\n                                </div>\n                            </label>\n                        </div>\n                    </div>\n                </section>\n                <!-- Code Editor View -->\n                <section class=\"flex-1 bg-white border border-[var(--line)] rounded-3xl p-8 card-shadow relative overflow-hidden flex flex-col editor-shadow\" data-kid=\"1-2-2-2-2\" data-name=\"code editor view section\">\n                    <div class=\"flex items-center justify-between mb-6 pb-4 border-b border-[var(--line)]/50\" data-kid=\"1-2-2-2-2-1\" data-name=\"editor header container\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"editor window controls\">\n                            <div class=\"flex gap-1.5\" data-kid=\"1-2-2-2-2-1-1-1\" data-name=\"editor window buttons container\">\n                                <div class=\"w-2.5 h-2.5 rounded-full bg-[var(--line)]\" data-kid=\"1-2-2-2-2-1-1-1-1\" data-name=\"window button red\">\n                                </div>\n                                <div class=\"w-2.5 h-2.5 rounded-full bg-[var(--line)]\" data-kid=\"1-2-2-2-2-1-1-1-2\" data-name=\"window button yellow\">\n                                </div>\n                                <div class=\"w-2.5 h-2.5 rounded-full bg-[var(--line)]\" data-kid=\"1-2-2-2-2-1-1-1-3\" data-name=\"window button green\">\n                                </div>\n                            </div>\n                            <span class=\"ml-4 text-[11px] font-mono text-[var(--muted)]\" data-kid=\"1-2-2-2-2-1-1-2\" data-name=\"editor filename display\">\n                                src/auth.js\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-4\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"editor metadata\">\n                            <span class=\"text-[10px] font-bold text-[var(--muted)] uppercase\" data-kid=\"1-2-2-2-2-1-2-1\" data-name=\"editor encoding label\">\n                                UTF-8\n                            </span>\n                            <span class=\"text-[10px] font-bold text-[var(--muted)] uppercase\" data-kid=\"1-2-2-2-2-1-2-2\" data-name=\"editor language label\">\n                                JavaScript\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"flex-1 font-mono text-[13px] leading-relaxed overflow-y-auto custom-scroll\" data-kid=\"1-2-2-2-2-2\" data-name=\"code content area\">\n                        <div class=\"flex\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"code line 1 container\">\n                            <span class=\"w-10 text-[var(--line)] select-none text-right pr-4\" data-kid=\"1-2-2-2-2-2-1-1\" data-name=\"line number 1\">\n                                1\n                            </span>\n                            <span data-kid=\"1-2-2-2-2-2-1-2\" data-name=\"code line 1 text\">\n                                <span class=\"text-[var(--pink)]\" data-kid=\"1-2-2-2-2-2-1-2-1\" data-name=\"syntax highlight import keyword\">\n                                    import\n                                </span>\n                                { validateToken }\n                                <span class=\"text-[var(--pink)]\" data-kid=\"1-2-2-2-2-2-1-2-2\" data-name=\"syntax highlight from keyword\">\n                                    from\n                                </span>\n                                <span class=\"text-[var(--sage)]\" data-kid=\"1-2-2-2-2-2-1-2-3\" data-name=\"syntax highlight string literal\">\n                                    './utils'\n                                </span>\n                                ;\n                            </span>\n                        </div>\n                        <div class=\"flex\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"code line 2 container\">\n                            <span class=\"w-10 text-[var(--line)] select-none text-right pr-4\" data-kid=\"1-2-2-2-2-2-2-1\" data-name=\"line number 2\">\n                                2\n                            </span>\n                            <span data-kid=\"1-2-2-2-2-2-2-2\" data-name=\"code line 2 text\">\n                            </span>\n                        </div>\n                        <div class=\"flex\" data-kid=\"1-2-2-2-2-2-3\" data-name=\"code line 3 container\">\n                            <span class=\"w-10 text-[var(--line)] select-none text-right pr-4\" data-kid=\"1-2-2-2-2-2-3-1\" data-name=\"line number 3\">\n                                3\n                            </span>\n                            <span data-kid=\"1-2-2-2-2-2-3-2\" data-name=\"code line 3 text\">\n                                <span class=\"text-[var(--sky)]\" data-kid=\"1-2-2-2-2-2-3-2-1\" data-name=\"syntax highlight export const keyword\">\n                                    export const\n                                </span>\n                                <span class=\"text-[var(--gold)]\" data-kid=\"1-2-2-2-2-2-3-2-2\" data-name=\"syntax highlight function name\">\n                                    handler\n                                </span>\n                                =\n                                <span class=\"text-[var(--sky)]\" data-kid=\"1-2-2-2-2-2-3-2-3\" data-name=\"syntax highlight async keyword\">\n                                    async\n                                </span>\n                                (event) => {\n                            </span>\n                        </div>\n                        <div class=\"flex\" data-kid=\"1-2-2-2-2-2-4\" data-name=\"code line 4 container\">\n                            <span class=\"w-10 text-[var(--line)] select-none text-right pr-4\" data-kid=\"1-2-2-2-2-2-4-1\" data-name=\"line number 4\">\n                                4\n                            </span>\n                            <span class=\"pl-6\" data-kid=\"1-2-2-2-2-2-4-2\" data-name=\"code line 4 text\">\n                                <span class=\"text-[var(--sky)]\" data-kid=\"1-2-2-2-2-2-4-2-1\" data-name=\"syntax highlight const keyword\">\n                                    const\n                                </span>\n                                { token, payload } =\n                                <span class=\"text-[var(--ink)]\" data-kid=\"1-2-2-2-2-2-4-2-2\" data-name=\"syntax highlight json global\">\n                                    JSON\n                                </span>\n                                .\n                                <span class=\"text-[var(--gold)]\" data-kid=\"1-2-2-2-2-2-4-2-3\" data-name=\"syntax highlight method parse\">\n                                    parse\n                                </span>\n                                (event.body);\n                            </span>\n                        </div>\n                        <div class=\"flex bg-[var(--coral)]/5\" data-kid=\"1-2-2-2-2-2-5\" data-name=\"code line 5 container\">\n                            <span class=\"w-10 text-[var(--line)] select-none text-right pr-4\" data-kid=\"1-2-2-2-2-2-5-1\" data-name=\"line number 5\">\n                                5\n                            </span>\n                            <span class=\"pl-6 border-l-2 border-[var(--coral)]\" data-kid=\"1-2-2-2-2-2-5-2\" data-name=\"code line 5 text\">\n                                <span class=\"text-[var(--sky)]\" data-kid=\"1-2-2-2-2-2-5-2-1\" data-name=\"syntax highlight const keyword\">\n                                    const\n                                </span>\n                                isValid =\n                                <span class=\"text-[var(--pink)]\" data-kid=\"1-2-2-2-2-2-5-2-2\" data-name=\"syntax highlight await keyword\">\n                                    await\n                                </span>\n                                <span class=\"text-[var(--gold)]\" data-kid=\"1-2-2-2-2-2-5-2-3\" data-name=\"syntax highlight method name\">\n                                    validateToken\n                                </span>\n                                (token);\n                                <span class=\"text-[var(--muted)]\" data-kid=\"1-2-2-2-2-2-5-2-4\" data-name=\"syntax highlight comment\">\n                                    // Error context\n                                </span>\n                            </span>\n                        </div>\n                        <div class=\"flex\" data-kid=\"1-2-2-2-2-2-6\" data-name=\"code line 6 container\">\n                            <span class=\"w-10 text-[var(--line)] select-none text-right pr-4\" data-kid=\"1-2-2-2-2-2-6-1\" data-name=\"line number 6\">\n                                6\n                            </span>\n                            <span class=\"pl-6\" data-kid=\"1-2-2-2-2-2-6-2\" data-name=\"code line 6 text\">\n                            </span>\n                        </div>\n                        <div class=\"flex\" data-kid=\"1-2-2-2-2-2-7\" data-name=\"code line 7 container\">\n                            <span class=\"w-10 text-[var(--line)] select-none text-right pr-4\" data-kid=\"1-2-2-2-2-2-7-1\" data-name=\"line number 7\">\n                                7\n                            </span>\n                            <span class=\"pl-6\" data-kid=\"1-2-2-2-2-2-7-2\" data-name=\"code line 7 text\">\n                                <span class=\"text-[var(--pink)]\" data-kid=\"1-2-2-2-2-2-7-2-1\" data-name=\"syntax highlight if keyword\">\n                                    if\n                                </span>\n                                (!isValid) {\n                            </span>\n                        </div>\n                        <div class=\"flex\" data-kid=\"1-2-2-2-2-2-8\" data-name=\"code line 8 container\">\n                            <span class=\"w-10 text-[var(--line)] select-none text-right pr-4\" data-kid=\"1-2-2-2-2-2-8-1\" data-name=\"line number 8\">\n                                8\n                            </span>\n                            <span class=\"pl-12 text-[var(--pink)]\" data-kid=\"1-2-2-2-2-2-8-2\" data-name=\"syntax highlight return keyword\">\n                                return\n                            </span>\n                            { statusCode:\n                            <span class=\"text-[var(--orange)]\" data-kid=\"1-2-2-2-2-2-8-3\" data-name=\"syntax highlight number\">\n                                401\n                            </span>\n                            };\n                        </div>\n                        <div class=\"flex\" data-kid=\"1-2-2-2-2-2-9\" data-name=\"code line 9 container\">\n                            <span class=\"w-10 text-[var(--line)] select-none text-right pr-4\" data-kid=\"1-2-2-2-2-2-9-1\" data-name=\"line number 9\">\n                                9\n                            </span>\n                            <span class=\"pl-6\" data-kid=\"1-2-2-2-2-2-9-2\" data-name=\"code line 9 text\">\n                                }\n                            </span>\n                        </div>\n                        <div class=\"flex\" data-kid=\"1-2-2-2-2-2-10\" data-name=\"code line 10 container\">\n                            <span class=\"w-10 text-[var(--line)] select-none text-right pr-4\" data-kid=\"1-2-2-2-2-2-10-1\" data-name=\"line number 10\">\n                                10\n                            </span>\n                            <span class=\"pl-6\" data-kid=\"1-2-2-2-2-2-10-2\" data-name=\"code line 10 text\">\n                            </span>\n                        </div>\n                        <div class=\"flex\" data-kid=\"1-2-2-2-2-2-11\" data-name=\"code line 11 container\">\n                            <span class=\"w-10 text-[var(--line)] select-none text-right pr-4\" data-kid=\"1-2-2-2-2-2-11-1\" data-name=\"line number 11\">\n                                11\n                            </span>\n                            <span class=\"pl-6 text-[var(--muted)] italic\" data-kid=\"1-2-2-2-2-2-11-2\" data-name=\"code line 11 text\">\n                                // Process the data securely\n                            </span>\n                        </div>\n                        <div class=\"flex\" data-kid=\"1-2-2-2-2-2-12\" data-name=\"code line 12 container\">\n                            <span class=\"w-10 text-[var(--line)] select-none text-right pr-4\" data-kid=\"1-2-2-2-2-2-12-1\" data-name=\"line number 12\">\n                                12\n                            </span>\n                            <span data-kid=\"1-2-2-2-2-2-12-2\" data-name=\"code line 12 text\">\n                                };\n                            </span>\n                        </div>\n                    </div>\n                </section>\n            </main>\n            <!-- Right Diagnosis Side (The Error Card) -->\n            <aside class=\"w-[440px] p-10 flex flex-col gap-6 relative\" data-kid=\"1-2-2-3\" data-name=\"diagnosis panel\" id=\"diagnosis-panel\">\n                <div class=\"error-card bg-white border border-[var(--line)] rounded-[32px] p-10 flex flex-col gap-8 card-shadow border-t-[12px] border-t-[var(--coral)] animate-entrance z-10\" data-kid=\"1-2-2-3-1\" data-name=\"error diagnosis card\">\n                    <div class=\"flex flex-col gap-2\" data-kid=\"1-2-2-3-1-1\" data-name=\"error card header\">\n                        <div class=\"w-fit px-3 py-1 bg-[var(--coral)]/10 text-[var(--coral)] rounded-full text-[10px] font-black uppercase tracking-widest\" data-kid=\"1-2-2-3-1-1-1\" data-name=\"error status tag\">\n                            Connection Error\n                        </div>\n                        <h2 class=\"font-serif text-[36px] leading-[1.1] tracking-tight mt-2 text-[var(--ink)]\" data-kid=\"1-2-2-3-1-1-2\" data-name=\"error title\">\n                            We couldn’t read this snippet.\n                        </h2>\n                    </div>\n                    <div class=\"flex flex-col gap-5\" data-kid=\"1-2-2-3-1-2\" data-name=\"error details container\">\n                        <p class=\"text-[var(--muted)] text-base leading-relaxed\" data-kid=\"1-2-2-3-1-2-1\" data-name=\"error description text\">\n                            Check the GitHub URL or paste valid code, then try again. The snippet may be private or formatted incorrectly.\n                        </p>\n                        <div class=\"flex flex-col gap-3 p-5 bg-[var(--cream)] rounded-2xl border border-[var(--line)]\" data-kid=\"1-2-2-3-1-2-2\" data-name=\"error cause box\">\n                            <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-3-1-2-2-1\" data-name=\"error cause label container\">\n                                <svg class=\"w-4 h-4 text-[var(--coral)]\" data-kid=\"1-2-2-3-1-2-2-1-1\" data-name=\"error warning icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\">\n                                    </path>\n                                </svg>\n                                <span class=\"text-xs font-bold uppercase tracking-wider text-[var(--ink)]\" data-kid=\"1-2-2-3-1-2-2-1-2\" data-name=\"error root cause title\">\n                                    Likely Root Cause\n                                </span>\n                            </div>\n                            <p class=\"text-xs text-[var(--muted)] leading-normal\" data-kid=\"1-2-2-3-1-2-2-2\" data-name=\"error root cause text\">\n                                The repository is private or your OAuth token has expired. Re-authentication might be required.\n                            </p>\n                        </div>\n                    </div>\n                    <button class=\"w-full h-16 bg-[var(--ink)] text-white rounded-2xl text-sm font-bold tracking-widest hover:bg-[#3a3040] transition-all hover:-translate-y-1 active:translate-y-0 shadow-lg shadow-[var(--ink)]/20\" data-kid=\"1-2-2-3-1-3\" data-name=\"try again button\">\n                        TRY AGAIN\n                    </button>\n                </div>\n                <!-- Secondary Context Card -->\n                <div class=\"bg-[var(--lav)]/15 border border-[var(--lav)]/40 rounded-[24px] p-6 flex flex-col gap-3 animate-entrance z-10\" data-kid=\"1-2-2-3-2\" data-name=\"quick tip card\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-3-2-1\" data-name=\"quick tip header\">\n                        <div class=\"w-8 h-8 rounded-full bg-[var(--lav)] flex items-center justify-center\" data-kid=\"1-2-2-3-2-1-1\" data-name=\"quick tip icon wrapper\">\n                            <svg class=\"w-4 h-4 text-[var(--lav-ink)]\" data-kid=\"1-2-2-3-2-1-1-1\" data-name=\"quick tip icon\" fill=\"currentColor\" viewbox=\"0 0 20 20\">\n                                <path clip-rule=\"evenodd\" d=\"M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z\" fill-rule=\"evenodd\">\n                                </path>\n                            </svg>\n                        </div>\n                        <span class=\"text-xs font-bold uppercase tracking-widest text-[var(--lav-ink)]\" data-kid=\"1-2-2-3-2-1-2\" data-name=\"quick tip title\">\n                            Quick Tip\n                        </span>\n                    </div>\n                    <p class=\"text-[13px] text-[var(--lav-ink)]/70 leading-relaxed\" data-kid=\"1-2-2-3-2-2\" data-name=\"quick tip description text\">\n                        Ensure you are targeting a direct file link (e.g.\n                        <code class=\"bg-[var(--lav)]/20 px-1 rounded\" data-kid=\"1-2-2-3-2-2-1\" data-name=\"quick tip example code\">\n                            /blob/main/file.js\n                        </code>\n                        ) rather than a directory.\n                    </p>\n                </div>\n            </aside>\n        </div>\n    </div>\n    <!-- GSAP for animations -->\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n    </script>\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n            // Entrance animations\n            gsap.from('.animate-entrance', {\n                y: 30,\n                stagger: 0.15,\n                duration: 1.2,\n                ease: 'expo.out',\n                delay: 0.2\n            });\n\n            // Ribbon subtle movement\n            gsap.to('#main-ribbon path', {\n                attr: { d: \"M1440 60C1210 160 1310 310 1110 460C910 610 960 760 760 860C560 960 610 1060 410 1110\" },\n                duration: 8,\n                repeat: -1,\n                yoyo: true,\n                ease: 'sine.inOut'\n            });\n\n            // Staggered history entrance\n            gsap.from('.history-card', {\n                x: -20,\n                opacity: 0,\n                stagger: 0.1,\n                duration: 0.8,\n                ease: 'power2.out',\n                delay: 0.5\n            });\n        });\n    </script>\n</div>\n",
      "comments": [],
      "created": "2026-08-02T17:20:22.765040+00:00",
      "modified": "2026-08-02T17:20:22.765040+00:00",
      "id": "var_9c84ede51f7a"
    },
    "var_73ab4eba3bda": {
      "type": "variant",
      "label": "CodeLens Login",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4620,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,700&family=JetBrains+Mono:wght@500&display=swap');\n\n  :root {\n    --ink: #241C2E;\n    --paper: #ffffff;\n    --cream: #FAF7F2;\n    --coral: #FF6B4A;\n    --gold: #F4B740;\n    --lav: #CDB8F7;\n    --sage: #8FBF6B;\n    --sky: #AEDDE4;\n    --pink: #F25C9A;\n    --orange: #F2884B;\n    --ribbon: #1C1730;\n  }\n\n  body {\n    margin: 0;\n    padding: 0;\n    background-color: var(--cream);\n    font-family: 'Inter', sans-serif;\n    color: var(--ink);\n    min-height: 100vh;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow-x: clip;\n  }\n\n  .font-serif { font-family: 'Playfair Display', Georgia, serif; }\n  .font-mono { font-family: 'JetBrains+Mono', monospace; }\n\n  .modal-shadow {\n    box-shadow: 0 40px 80px -20px rgba(20, 16, 46, 0.45), 0 10px 30px rgba(20, 16, 46, 0.2);\n  }\n\n  .tile {\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n    padding: 1.5rem;\n    overflow: hidden;\n  }\n\n  .editorial-card {\n    border-radius: 10px;\n    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    padding: 1rem;\n    width: 85%;\n    aspect-ratio: 1/1.25;\n    z-index: 2;\n  }\n\n  .ribbon-path {\n    stroke-dasharray: 2000;\n    stroke-dashoffset: 2000;\n  }\n\n  .google-btn {\n    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n  .google-btn:hover {\n    background-color: #f9fafb;\n    transform: translateY(-1px);\n    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);\n  }\n\n  @media (max-width: 860px) {\n    .main-grid {\n      grid-template-columns: 1fr;\n      height: auto !important;\n      max-width: 480px;\n    }\n    .mosaic-panel {\n      height: 480px;\n    }\n  }\n</style>\n<main class=\"w-full flex justify-center p-6\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"main-grid modal-shadow w-full max-w-[1020px] h-[680px] bg-white rounded-[24px] overflow-hidden grid grid-cols-[42%_1fr] relative\" data-kid=\"1-1\" data-name=\"authentication and visual mosaic container\">\n        <!-- Close Button -->\n        <button class=\"absolute top-8 left-8 z-50 flex items-center gap-2 bg-white/90 backdrop-blur-sm border border-gray-100 px-4 py-2 rounded-full text-[10px] font-black tracking-widest text-[var(--ink)] shadow-md hover:bg-white transition-all cursor-pointer group\" data-kid=\"1-1-1\" data-name=\"close button\">\n            <svg class=\"w-3 h-3 group-hover:rotate-90 transition-transform duration-300\" data-kid=\"1-1-1-1\" data-name=\"cross icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"3\" viewbox=\"0 0 24 24\">\n                <line x1=\"18\" x2=\"6\" y1=\"6\" y2=\"18\">\n                </line>\n                <line x1=\"6\" x2=\"18\" y1=\"6\" y2=\"18\">\n                </line>\n            </svg>\n            CLOSE\n        </button>\n        <!-- LEFT: AUTH PANEL -->\n        <section class=\"auth-panel p-12 lg:p-16 flex flex-col items-center justify-center text-center gap-10 bg-white\" data-kid=\"1-1-2\" data-name=\"authentication section\">\n            <div class=\"auth-animate flex flex-col items-center gap-6 w-full max-w-sm\" data-kid=\"1-1-2-1\" data-name=\"authentication content wrapper\">\n                <!-- Logo -->\n                <div class=\"flex items-center gap-3 text-xl font-bold tracking-tight\" data-kid=\"1-1-2-1-1\" data-name=\"logo container\">\n                    <div class=\"w-10 h-10 rounded-full border-2 border-[var(--ink)] flex items-center justify-center relative\" data-kid=\"1-1-2-1-1-1\" data-name=\"logo icon container\">\n                        <svg class=\"w-5 h-5 fill-none stroke-[var(--ink)]\" data-kid=\"1-1-2-1-1-1-1\" data-name=\"code lens logo icon\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                            <path d=\"M7 8l-4 4 4 4M17 8l4 4-4 4M13 5l-2 14\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            </path>\n                        </svg>\n                        <div class=\"absolute -top-0.5 -right-0.5 w-2 h-2 bg-[var(--coral)] rounded-full border border-white\" data-kid=\"1-1-2-1-1-1-2\" data-name=\"logo accent dot\">\n                        </div>\n                    </div>\n                    <span class=\"text-[22px]\" data-kid=\"1-1-2-1-1-2\" data-name=\"brand name text\">\n                        CodeLens\n                    </span>\n                </div>\n                <!-- Copy -->\n                <div class=\"space-y-4\" data-kid=\"1-1-2-1-2\" data-name=\"headline text container\">\n                    <h1 class=\"text-[44px] leading-[1.05] font-serif italic text-[var(--ink)]\" data-kid=\"1-1-2-1-2-1\" data-name=\"hero headline text\" style=\"font-family: Georgia, 'Playfair Display', serif;\">\n                        Welcome back.\n                    </h1>\n                    <p class=\"text-gray-500 text-[18px] font-medium leading-relaxed max-w-[280px] mx-auto\" data-kid=\"1-1-2-1-2-2\" data-name=\"hero subheadline description text\">\n                        Your code has patterns worth seeing.\n                    </p>\n                </div>\n                <!-- Google Auth -->\n                <div class=\"w-full space-y-4 pt-2\" data-kid=\"1-1-2-1-3\" data-name=\"authentication actions wrapper\">\n                    <button class=\"google-btn w-full flex items-center justify-center gap-3 py-4 px-6 border border-gray-200 rounded-full bg-white shadow-sm cursor-pointer\" data-kid=\"1-1-2-1-3-1\" data-name=\"google sign-in button\">\n                        <svg class=\"w-5 h-5\" data-kid=\"1-1-2-1-3-1-1\" data-name=\"google logo icon\" viewbox=\"0 0 24 24\">\n                            <path d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\" fill=\"#4285F4\">\n                            </path>\n                            <path d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\" fill=\"#34A853\">\n                            </path>\n                            <path d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z\" fill=\"#FBBC05\">\n                            </path>\n                            <path d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\" fill=\"#EA4335\">\n                            </path>\n                        </svg>\n                        <span class=\"font-bold text-[15px] text-[var(--ink)]\" data-kid=\"1-1-2-1-3-1-2\" data-name=\"google sign-in label\">\n                            Continue with Google\n                        </span>\n                    </button>\n                    <p class=\"text-[11px] text-gray-500 uppercase tracking-[0.25em] font-bold opacity-80\" data-kid=\"1-1-2-1-3-2\" data-name=\"authentication footer label\">\n                        A clearer signal for every commit.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <!-- RIGHT: MOSAIC PANEL -->\n        <section class=\"mosaic-panel relative grid grid-cols-3 grid-rows-4 bg-white overflow-hidden\" data-kid=\"1-1-3\" data-name=\"visual mosaic panel\">\n            <!-- Ribbon SVG -->\n            <svg class=\"absolute inset-0 w-full h-full pointer-events-none z-10\" data-kid=\"1-1-3-1\" data-name=\"ribbon svg container\" preserveaspectratio=\"none\" viewbox=\"0 0 600 680\">\n                <path class=\"ribbon-path\" d=\"M600,80 C500,160 550,260 400,340 C250,420 300,560 160,640 C80,700 40,800 -80,900\" fill=\"none\" id=\"ribbon-path\" opacity=\"0.95\" stroke=\"var(--ink)\" stroke-linecap=\"round\" stroke-width=\"18\">\n                </path>\n            </svg>\n            <!-- Row 1 -->\n            <div class=\"tile bg-white border-b border-r border-[#e7e2da]\" data-kid=\"1-1-3-2\" data-name=\"tile\">\n                <div class=\"w-full h-24 bg-gray-50/50 rounded-xl p-3 border border-gray-100 flex flex-col gap-2.5 overflow-hidden\" data-kid=\"1-1-3-2-1\" data-name=\"data code snippet placeholder\">\n                    <div class=\"w-3/4 h-1.5 bg-slate-200 rounded-full\" data-kid=\"1-1-3-2-1-1\" data-name=\"snippet line 1\">\n                    </div>\n                    <div class=\"w-1/2 h-1.5 bg-slate-200 rounded-full\" data-kid=\"1-1-3-2-1-2\" data-name=\"snippet line 2\">\n                    </div>\n                    <div class=\"w-5/6 h-1.5 bg-[var(--lav)] opacity-40 rounded-full\" data-kid=\"1-1-3-2-1-3\" data-name=\"snippet line 3\">\n                    </div>\n                    <div class=\"w-2/3 h-1.5 bg-slate-200 rounded-full\" data-kid=\"1-1-3-2-1-4\" data-name=\"snippet line 4\">\n                    </div>\n                    <div class=\"w-1/3 h-1.5 bg-slate-200 rounded-full\" data-kid=\"1-1-3-2-1-5\" data-name=\"snippet line 5\">\n                    </div>\n                </div>\n            </div>\n            <div class=\"tile bg-[var(--coral)] text-white text-center\" data-kid=\"1-1-3-3\" data-name=\"tile\">\n                <h2 class=\"font-serif text-[26px] font-bold leading-[1.15]\" data-kid=\"1-1-3-3-1\" data-name=\"tile headline text\">\n                    Find the\n                    <br data-kid=\"1-1-3-3-1-1\" data-name=\"line break\"/>\n                    blind spot.\n                </h2>\n            </div>\n            <div class=\"tile bg-[var(--lav)]\" data-kid=\"1-1-3-4\" data-name=\"tile\">\n                <div class=\"editorial-card bg-white/95 rotate-3 -translate-y-2\" data-kid=\"1-1-3-4-1\" data-name=\"feature card\">\n                    <span class=\"font-mono text-[13px] font-bold text-[var(--lav)] tracking-widest uppercase\" data-kid=\"1-1-3-4-1-1\" data-name=\"feature card label\">\n                        ALGORITHM\n                    </span>\n                </div>\n            </div>\n            <!-- Row 2 -->\n            <div class=\"tile bg-[var(--sage)]\" data-kid=\"1-1-3-5\" data-name=\"tile\">\n                <div class=\"editorial-card bg-[#e7dcc3] -rotate-2 shadow-lg scale-105\" data-kid=\"1-1-3-5-1\" data-name=\"feature card\">\n                    <div class=\"flex flex-col items-center gap-2\" data-kid=\"1-1-3-5-1-1\" data-name=\"security icon wrapper\">\n                        <div class=\"w-9 h-9 rounded-full border-2 border-[#3a3115] flex items-center justify-center\" data-kid=\"1-1-3-5-1-1-1\" data-name=\"security icon container\">\n                            <svg class=\"w-5 h-5 text-[#3a3115]\" data-kid=\"1-1-3-5-1-1-1-1\" data-name=\"security shield icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\">\n                                </path>\n                            </svg>\n                        </div>\n                        <span class=\"font-serif text-[11px] font-black text-[#3a3115] tracking-widest\" data-kid=\"1-1-3-5-1-1-2\" data-name=\"security feature label\">\n                            SECURITY\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"tile bg-[var(--gold)]\" data-kid=\"1-1-3-6\" data-name=\"tile\">\n                <div class=\"w-[85%] h-[75%] bg-[var(--ink)] rounded-xl shadow-xl p-4 flex flex-col justify-between overflow-hidden relative\" data-kid=\"1-1-3-6-1\" data-name=\"feature card\">\n                    <div class=\"h-1/2 w-full flex items-center justify-center opacity-80\" data-kid=\"1-1-3-6-1-1\" data-name=\"icon container\">\n                        <svg class=\"w-12 h-12 text-[var(--sky)]\" data-kid=\"1-1-3-6-1-1-1\" data-name=\"pulse icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\">\n                            <polyline points=\"22 12 18 12 15 21 9 3 6 12 2 12\">\n                            </polyline>\n                        </svg>\n                    </div>\n                    <div class=\"space-y-1.5\" data-kid=\"1-1-3-6-1-2\" data-name=\"data bars container\">\n                        <div class=\"h-1 w-full bg-white/20 rounded-full\" data-kid=\"1-1-3-6-1-2-1\" data-name=\"data bar 1\">\n                        </div>\n                        <div class=\"h-1 w-2/3 bg-white/20 rounded-full\" data-kid=\"1-1-3-6-1-2-2\" data-name=\"data bar 2\">\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"tile bg-[var(--sky)]\" data-kid=\"1-1-3-7\" data-name=\"tile\">\n                <div class=\"w-16 h-16 bg-white rounded-full flex items-center justify-center shadow-md border border-sky-100\" data-kid=\"1-1-3-7-1\" data-name=\"search icon container\">\n                    <svg class=\"w-8 h-8 text-[#204248]\" data-kid=\"1-1-3-7-1-1\" data-name=\"search glass icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n                        <circle cx=\"11\" cy=\"11\" r=\"8\">\n                        </circle>\n                        <line x1=\"21\" x2=\"16.65\" y1=\"21\" y2=\"16.65\">\n                        </line>\n                    </svg>\n                </div>\n            </div>\n            <!-- Row 3 -->\n            <div class=\"tile bg-[var(--pink)]\" data-kid=\"1-1-3-8\" data-name=\"tile\">\n                <div class=\"flex items-end gap-1.5 h-14\" data-kid=\"1-1-3-8-1\" data-name=\"bar chart container\">\n                    <div class=\"w-2.5 bg-white/90 rounded-t-sm h-1/3\" data-kid=\"1-1-3-8-1-1\" data-name=\"bar 1\">\n                    </div>\n                    <div class=\"w-2.5 bg-white rounded-t-sm h-full\" data-kid=\"1-1-3-8-1-2\" data-name=\"bar 2\">\n                    </div>\n                    <div class=\"w-2.5 bg-white/90 rounded-t-sm h-1/2\" data-kid=\"1-1-3-8-1-3\" data-name=\"bar 3\">\n                    </div>\n                    <div class=\"w-2.5 bg-white/70 rounded-t-sm h-2/3\" data-kid=\"1-1-3-8-1-4\" data-name=\"bar 4\">\n                    </div>\n                </div>\n            </div>\n            <div class=\"tile bg-[var(--orange)]\" data-kid=\"1-1-3-9\" data-name=\"tile\">\n                <div class=\"w-14 h-14 rounded-2xl bg-white/20 flex items-center justify-center rotate-12 backdrop-blur-sm border border-white/30\" data-kid=\"1-1-3-9-1\" data-name=\"icon container\">\n                    <svg class=\"w-8 h-8 text-white\" data-kid=\"1-1-3-9-1-1\" data-name=\"search icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n                        <path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\">\n                        </path>\n                    </svg>\n                </div>\n            </div>\n            <div class=\"tile bg-white border-l border-t border-[#e7e2da] text-left items-start px-8\" data-kid=\"1-1-3-10\" data-name=\"tile\">\n                <h3 class=\"font-serif text-[24px] font-bold text-[var(--ink)] leading-tight\" data-kid=\"1-1-3-10-1\" data-name=\"tile title\">\n                    Deep\n                    <br data-kid=\"1-1-3-10-1-1\" data-name=\"line break\"/>\n                    Scan.\n                </h3>\n                <svg class=\"w-5 h-5 mt-4 opacity-40\" data-kid=\"1-1-3-10-2\" data-name=\"arrow icon\" fill=\"currentColor\" viewbox=\"0 0 24 24\">\n                    <circle cx=\"12\" cy=\"12\" r=\"10\">\n                    </circle>\n                    <path d=\"M12 16l4-4-4-4\" fill=\"none\" stroke=\"white\" stroke-width=\"2\">\n                    </path>\n                </svg>\n            </div>\n            <!-- Row 4 -->\n            <div class=\"tile bg-[var(--sky)] items-end justify-end text-right px-8 pb-8\" data-kid=\"1-1-3-11\" data-name=\"tile\">\n                <span class=\"font-serif text-[24px] font-bold text-sky-900 leading-tight\" data-kid=\"1-1-3-11-1\" data-name=\"tile title\">\n                    Clean\n                    <br data-kid=\"1-1-3-11-1-1\" data-name=\"line break\"/>\n                    Code.\n                </span>\n            </div>\n            <div class=\"tile bg-[var(--lav)]\" data-kid=\"1-1-3-12\" data-name=\"tile\">\n                <div class=\"editorial-card bg-[var(--ink)] shadow-2xl translate-y-2\" data-kid=\"1-1-3-12-1\" data-name=\"feature card\">\n                    <span class=\"font-serif text-[12px] text-white tracking-[0.3em] font-bold uppercase opacity-85\" data-kid=\"1-1-3-12-1-1\" data-name=\"feature label\">\n                        PATTERNS\n                    </span>\n                </div>\n            </div>\n            <div class=\"tile bg-[var(--sage)]\" data-kid=\"1-1-3-13\" data-name=\"tile\">\n                <div class=\"w-20 h-12 bg-[#264014] rounded-lg opacity-30 blur-[1px]\" data-kid=\"1-1-3-13-1\" data-name=\"decorative shape\">\n                </div>\n                <div class=\"absolute inset-0 flex items-center justify-center\" data-kid=\"1-1-3-13-2\" data-name=\"container\">\n                    <div class=\"w-10 h-10 border-2 border-white/40 rounded-full\" data-kid=\"1-1-3-13-2-1\" data-name=\"circle border\">\n                    </div>\n                </div>\n            </div>\n        </section>\n    </div>\n</main>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    window.addEventListener('DOMContentLoaded', () => {\n    // Entrance animations\n    const tl = gsap.timeline({ defaults: { ease: \"power4.out\", duration: 1.2 } });\n\n    tl.from('.main-grid', {\n      y: 100,\n      opacity: 0,\n      duration: 1.5,\n      ease: \"expo.out\"\n    });\n\n    tl.from('.auth-animate', {\n      y: 30,\n      opacity: 0,\n      stagger: 0.15\n    }, \"-=1.2\");\n\n    tl.from('.tile', {\n      scale: 1.05,\n      opacity: 0,\n      stagger: {\n        amount: 0.8,\n        grid: [4, 3],\n        from: \"center\"\n      }\n    }, \"-=1.2\");\n\n    tl.to('#ribbon-path', {\n      strokeDashoffset: 0,\n      duration: 2.5,\n      ease: \"power2.inOut\"\n    }, \"-=1.5\");\n\n    // Subtle hover effect for the tiles - using explicit selectors for children\n    document.querySelectorAll('.tile').forEach(tile => {\n      const target = tile.querySelector('.editorial-card') || \n                     tile.querySelector('.w-16') || \n                     tile.querySelector('.w-14') || \n                     tile.querySelector('div:first-child');\n      \n      if (target) {\n        tile.addEventListener('mouseenter', () => {\n          gsap.to(target, {\n            y: -8,\n            scale: 1.04,\n            duration: 0.5,\n            ease: \"back.out(1.7)\",\n            overwrite: true\n          });\n        });\n        tile.addEventListener('mouseleave', () => {\n          gsap.to(target, {\n            y: 0,\n            scale: 1,\n            duration: 0.5,\n            ease: \"power2.inOut\",\n            overwrite: true\n          });\n        });\n      }\n    });\n  });\n</script>\n",
      "comments": [],
      "created": "2026-08-02T17:20:22.943256+00:00",
      "modified": "2026-08-02T17:20:22.943256+00:00",
      "id": "var_73ab4eba3bda"
    },
    "var_bc1415621830": {
      "type": "variant",
      "label": "CodeLens Landing",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 6160,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n  \n  :root {\n    --cream: #FAF7F2;\n    --ink: #241C2E;\n    --ink-soft: #3a3040;\n    --coral: #FF6B4A;\n    --gold: #F4B740;\n    --lav: #CDB8F7;\n    --sage: #8FBF6B;\n    --sky: #AEDDE4;\n    --pink: #F25C9A;\n    --orange: #F2884B;\n    --font-serif: Georgia, \"Times New Roman\", serif;\n    --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;\n  }\n\n  body {\n    background-color: var(--cream);\n    color: var(--ink);\n    font-family: var(--font-sans);\n    line-height: 1.5;\n    overflow-x: clip; /* Prevent ribbon from causing horizontal scroll */\n  }\n\n  .serif { font-family: var(--font-serif); }\n\n  .human-collage {\n    perspective: 1000px;\n  }\n\n  .pill-button {\n    border-radius: 9999px;\n    padding: 0.75rem 2rem;\n    font-weight: 700;\n    font-size: 0.875rem;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n  }\n\n  .nav-blur {\n    backdrop-filter: blur(8px);\n    background-color: rgba(250, 247, 242, 0.8);\n    border-bottom: 1px solid rgba(36, 28, 46, 0.1);\n  }\n\n  .collage-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    grid-template-rows: repeat(4, 1fr);\n    gap: 0;\n    border-radius: 24px;\n    overflow: hidden;\n    box-shadow: 0 40px 80px -20px rgba(36, 28, 46, 0.25);\n    background: #fff;\n  }\n\n  .tile {\n    padding: 1.5rem;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    position: relative;\n    min-height: 140px;\n  }\n\n  .ribbon-trace {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    z-index: 20;\n    pointer-events: none;\n  }\n\n  .feature-card {\n    position: relative;\n  }\n\n  /* Code snippet mock */\n  .code-block {\n    background: rgba(255, 255, 255, 0.15);\n    backdrop-filter: blur(4px);\n    border: 1px solid rgba(255, 255, 255, 0.3);\n    border-radius: 12px;\n    padding: 1rem;\n    font-family: monospace;\n    font-size: 0.75rem;\n    color: white;\n  }\n\n  .severity-badge {\n    background: var(--ink);\n    color: var(--gold);\n    padding: 6px 14px;\n    border-radius: 999px;\n    font-weight: 800;\n    font-size: 0.65rem;\n    letter-spacing: 0.1em;\n    display: inline-block;\n  }\n\n  .lock-tile-icon {\n    box-shadow: 0 10px 30px rgba(0,0,0,0.1);\n  }\n</style>\n<!-- Navigation -->\n<nav class=\"fixed top-0 left-0 w-full z-50 nav-blur px-8 py-5 flex items-center justify-between m-0 p-0 border-box\" data-kid=\"1\" data-name=\"main navigation bar\">\n    <a class=\"flex items-center gap-3\" data-kid=\"1-1\" data-name=\"brand identity container\" href=\"/\">\n        <div class=\"w-8 h-8 rounded-full border-2 border-[var(--ink)] flex items-center justify-center font-bold text-lg\" data-kid=\"1-1-1\" data-name=\"brand logo icon\">\n            C\n        </div>\n        <span class=\"font-bold text-xl tracking-tight\" data-kid=\"1-1-2\" data-name=\"brand name text\">\n            CodeLens\n        </span>\n    </a>\n    <div class=\"flex items-center gap-8\" data-kid=\"1-2\" data-name=\"navigation link wrapper\">\n        <a class=\"text-sm font-bold uppercase tracking-widest text-[var(--ink)] hover:opacity-70 transition-opacity\" data-kid=\"1-2-1\" data-name=\"sign in navigation link\" href=\"/login\">\n            Sign In\n        </a>\n    </div>\n</nav>\n<main class=\"pt-24\" data-kid=\"2\" data-name=\"main page content area\">\n    <!-- Hero Section -->\n    <section class=\"container mx-auto px-6 py-16 lg:py-24 grid lg:grid-cols-2 gap-16 items-center relative\" data-kid=\"2-1\" data-name=\"hero section\">\n        <!-- Hero Text -->\n        <div class=\"max-w-xl hero-content\" data-kid=\"2-1-1\" data-name=\"hero content container\">\n            <h1 class=\"serif text-6xl lg:text-7xl font-bold leading-[1.05] text-[var(--ink)] mb-8\" data-kid=\"2-1-1-1\" data-name=\"hero headline\">\n                See the pattern\n                <br data-kid=\"2-1-1-1-1\" data-name=\"headline line break\"/>\n                <span class=\"italic font-normal\" data-kid=\"2-1-1-1-2\" data-name=\"hero headline italic emphasis\">\n                    before it costs you.\n                </span>\n            </h1>\n            <p class=\"text-xl lg:text-2xl text-[var(--ink-soft)]/80 mb-12 leading-relaxed max-w-lg\" data-kid=\"2-1-1-2\" data-name=\"hero subheadline description\">\n                CodeLens detects algorithmic inefficiencies and security vulnerabilities in real-time, mapping the patterns that slow your team down.\n            </p>\n            <a class=\"pill-button bg-[var(--ink)] text-white shadow-lg shadow-[var(--ink)]/20 group\" data-kid=\"2-1-1-3\" data-name=\"primary call-to-action button\" href=\"/login\">\n                Start analyzing\n                <svg class=\"w-4 h-4 ml-2\" data-kid=\"2-1-1-3-1\" data-name=\"arrow right icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                    <path d=\"M13 7l5 5m0 0l-5 5m5-5H6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"3\">\n                    </path>\n                </svg>\n            </a>\n        </div>\n        <!-- Hero Collage -->\n        <div class=\"relative hero-collage human-collage\" data-kid=\"2-1-2\" data-name=\"hero collage container\">\n            <!-- Thick Dark Ribbon Trace -->\n            <svg class=\"ribbon-trace\" data-dynamic=\"true\" data-kid=\"2-1-2-1\" data-name=\"hero background ribbon graphic\" data-reason=\"stroke-dashoffset modified on scroll by gsap\" preserveaspectratio=\"none\" viewbox=\"0 0 500 700\">\n                <path d=\"M550,-50 C400,150 600,350 300,450 C100,520 -100,650 -50,850\" fill=\"none\" id=\"heroRibbon\" opacity=\"1\" stroke=\"var(--ink)\" stroke-linecap=\"round\" stroke-width=\"50\">\n                </path>\n            </svg>\n            <div class=\"collage-grid aspect-[4/5]\" data-kid=\"2-1-2-2\" data-name=\"collage grid layout\">\n                <!-- Row 1 -->\n                <div class=\"tile bg-[var(--sky)] col-span-1 z-10\" data-kid=\"2-1-2-2-1\" data-name=\"code diagnostic tile\">\n                    <div class=\"w-10 h-10 bg-white/40 rounded-full flex items-center justify-center\" data-kid=\"2-1-2-2-1-1\" data-name=\"diagnostic icon background\">\n                        <svg class=\"w-5 h-5\" data-kid=\"2-1-2-2-1-1-1\" data-name=\"diagnostic icon\" fill=\"var(--ink)\" viewbox=\"0 0 20 20\">\n                            <path d=\"M9 2a1 1 0 000 2h2a1 1 0 100-2H9z\">\n                            </path>\n                            <path clip-rule=\"evenodd\" d=\"M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z\" fill-rule=\"evenodd\">\n                            </path>\n                        </svg>\n                    </div>\n                    <span class=\"text-[10px] uppercase tracking-widest mt-auto font-bold opacity-40\" data-kid=\"2-1-2-2-1-2\" data-name=\"diagnostic tile label\">\n                        Code Diagnostic\n                    </span>\n                </div>\n                <div class=\"tile bg-[var(--coral)] col-span-2\" data-kid=\"2-1-2-2-2\" data-name=\"code snippet tile\">\n                    <div class=\"code-block\" data-kid=\"2-1-2-2-2-1\" data-name=\"code snippet block\">\n                        <span class=\"opacity-50\" data-kid=\"2-1-2-2-2-1-1\" data-name=\"code line number one\">\n                            04\n                        </span>\n                        while(ptr != null) {\n                        <br data-kid=\"2-1-2-2-2-1-2\" data-name=\"code snippet line break\"/>\n                        <span class=\"opacity-50\" data-kid=\"2-1-2-2-2-1-3\" data-name=\"code line number two\">\n                            05\n                        </span>\n                        process(ptr);\n                        <br data-kid=\"2-1-2-2-2-1-4\" data-name=\"code snippet line break\"/>\n                        <span class=\"opacity-50\" data-kid=\"2-1-2-2-2-1-5\" data-name=\"code line number three\">\n                            06\n                        </span>\n                        ptr = ptr.next;\n                        <br data-kid=\"2-1-2-2-2-1-6\" data-name=\"code snippet line break\"/>\n                        <span class=\"opacity-50\" data-kid=\"2-1-2-2-2-1-7\" data-name=\"code line number four\">\n                            07\n                        </span>\n                        }\n                    </div>\n                </div>\n                <!-- Row 2 -->\n                <div class=\"tile bg-[var(--gold)] col-span-2 z-10\" data-kid=\"2-1-2-2-3\" data-name=\"critical logic tile\">\n                    <h3 class=\"serif text-3xl font-bold text-[var(--ink)] leading-tight\" data-kid=\"2-1-2-2-3-1\" data-name=\"critical logic title\">\n                        Complex Logic\n                        <br data-kid=\"2-1-2-2-3-1-1\" data-name=\"critical logic title line break\"/>\n                        Detected\n                    </h3>\n                    <div class=\"severity-badge mt-4\" data-kid=\"2-1-2-2-3-2\" data-name=\"severity badge\">\n                        SEVERITY: CRITICAL\n                    </div>\n                </div>\n                <div class=\"tile bg-[var(--lav)] col-span-1 items-center z-20\" data-kid=\"2-1-2-2-4\" data-name=\"lock icon tile\">\n                    <div class=\"w-20 h-20 bg-white rounded-3xl lock-tile-icon flex items-center justify-center -rotate-12 mt-4\" data-kid=\"2-1-2-2-4-1\" data-name=\"lock icon background\">\n                        <svg class=\"w-10 h-10 text-[var(--pink)]\" data-kid=\"2-1-2-2-4-1-1\" data-name=\"lock icon\" fill=\"currentColor\" viewbox=\"0 0 20 20\">\n                            <path clip-rule=\"evenodd\" d=\"M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z\" fill-rule=\"evenodd\">\n                            </path>\n                        </svg>\n                    </div>\n                </div>\n                <!-- Row 3 -->\n                <div class=\"tile bg-[var(--sage)] col-span-1 z-10\" data-kid=\"2-1-2-2-5\" data-name=\"pattern trace tile\">\n                    <div class=\"flex flex-col gap-2 w-full opacity-60 mt-4\" data-kid=\"2-1-2-2-5-1\" data-name=\"pattern visualization container\">\n                        <div class=\"h-2.5 bg-[var(--ink)] rounded-full w-full\" data-kid=\"2-1-2-2-5-1-1\" data-name=\"pattern bar one\">\n                        </div>\n                        <div class=\"h-2.5 bg-[var(--ink)] rounded-full w-[85%]\" data-kid=\"2-1-2-2-5-1-2\" data-name=\"pattern bar two\">\n                        </div>\n                        <div class=\"h-2.5 bg-[var(--ink)] rounded-full w-[60%]\" data-kid=\"2-1-2-2-5-1-3\" data-name=\"pattern bar three\">\n                        </div>\n                    </div>\n                    <span class=\"text-[10px] font-bold mt-auto opacity-40 tracking-widest\" data-kid=\"2-1-2-2-5-2\" data-name=\"pattern trace label\">\n                        PATTERN TRACE\n                    </span>\n                </div>\n                <div class=\"tile bg-[var(--ink)] col-span-2 text-white overflow-hidden z-20 group\" data-kid=\"2-1-2-2-6\" data-name=\"quote tile\">\n                    <div class=\"absolute -right-4 -bottom-4 w-32 h-32 bg-[var(--coral)] rounded-full opacity-30 blur-3xl group-hover:scale-150 transition-transform duration-1000\" data-kid=\"2-1-2-2-6-1\" data-name=\"quote decorative glow background\">\n                    </div>\n                    <p class=\"serif italic text-2xl relative z-10 leading-tight\" data-kid=\"2-1-2-2-6-2\" data-name=\"quote text\">\n                        \"Code is poetry,\n                        <br data-kid=\"2-1-2-2-6-2-1\" data-name=\"quote line break\"/>\n                        bugs are the noise.\"\n                    </p>\n                </div>\n                <!-- Row 4 -->\n                <div class=\"tile bg-[var(--pink)] col-span-2 justify-end\" data-kid=\"2-1-2-2-7\" data-name=\"improvement velocity tile\">\n                    <div class=\"flex items-end gap-1 h-12\" data-kid=\"2-1-2-2-7-1\" data-name=\"velocity chart container\">\n                        <div class=\"w-3 bg-white/40 h-1/2 rounded-t-sm\" data-kid=\"2-1-2-2-7-1-1\" data-name=\"velocity bar one\">\n                        </div>\n                        <div class=\"w-3 bg-white/60 h-3/4 rounded-t-sm\" data-kid=\"2-1-2-2-7-1-2\" data-name=\"velocity bar two\">\n                        </div>\n                        <div class=\"w-3 bg-white/80 h-1/3 rounded-t-sm\" data-kid=\"2-1-2-2-7-1-3\" data-name=\"velocity bar three\">\n                        </div>\n                        <div class=\"w-3 bg-white h-full rounded-t-sm\" data-kid=\"2-1-2-2-7-1-4\" data-name=\"velocity bar four\">\n                        </div>\n                        <div class=\"w-3 bg-white/50 h-2/3 rounded-t-sm\" data-kid=\"2-1-2-2-7-1-5\" data-name=\"velocity bar five\">\n                        </div>\n                    </div>\n                    <span class=\"text-[10px] text-white font-bold mt-2 uppercase tracking-tighter\" data-kid=\"2-1-2-2-7-2\" data-name=\"velocity chart label\">\n                        Improvement Velocity\n                    </span>\n                </div>\n                <div class=\"tile bg-[var(--orange)] col-span-1 items-center justify-center\" data-kid=\"2-1-2-2-8\" data-name=\"brand mark tile\">\n                    <div class=\"w-12 h-12 border-2 border-white/40 rounded-full flex items-center justify-center text-white font-serif text-xl italic\" data-kid=\"2-1-2-2-8-1\" data-name=\"brand mark circular badge\">\n                        CL\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Features Grid - Rebuilt for Editorial Collage Feel -->\n    <section class=\"container mx-auto px-6 py-32 border-t border-[var(--ink)]/5\" data-kid=\"2-2\" data-name=\"features section\">\n        <div class=\"grid grid-cols-12 gap-8 items-start\" data-kid=\"2-2-1\" data-name=\"features grid\">\n            <!-- Feature 1: Stretched -->\n            <div class=\"feature-card col-span-12 lg:col-span-5 bg-[var(--lav)] p-12 rounded-[32px] shadow-lg shadow-[var(--lav)]/10\" data-kid=\"2-2-1-1\" data-name=\"algo diagnosis feature card\">\n                <div class=\"w-16 h-16 bg-white/40 rounded-2xl flex items-center justify-center mb-10\" data-kid=\"2-2-1-1-1\" data-name=\"feature icon container\">\n                    <svg class=\"w-10 h-10 text-[var(--ink)]\" data-kid=\"2-2-1-1-1-1\" data-name=\"algo diagnosis icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                        <path d=\"M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\">\n                        </path>\n                    </svg>\n                </div>\n                <h4 class=\"serif text-5xl font-bold mb-6 text-[var(--ink)] leading-tight\" data-kid=\"2-2-1-1-2\" data-name=\"feature title\">\n                    Algo Diagnosis\n                </h4>\n                <p class=\"text-[var(--ink)]/70 text-xl leading-relaxed max-w-sm\" data-kid=\"2-2-1-1-3\" data-name=\"feature description\">\n                    Pinpoint computational bottlenecks before they escalate into production failures with automated Big-O analysis.\n                </p>\n            </div>\n            <!-- Feature 2: Overlapping/Taller -->\n            <div class=\"feature-card col-span-12 lg:col-span-7 bg-[var(--coral)] p-12 rounded-[32px] text-white shadow-lg shadow-[var(--coral)]/20 lg:-mt-12\" data-kid=\"2-2-1-2\" data-name=\"security scan feature card\">\n                <div class=\"w-16 h-16 bg-white/20 rounded-2xl flex items-center justify-center mb-10\" data-kid=\"2-2-1-2-1\" data-name=\"feature icon container\">\n                    <svg class=\"w-10 h-10 text-white\" data-kid=\"2-2-1-2-1-1\" data-name=\"security scan icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                        <path d=\"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\">\n                        </path>\n                    </svg>\n                </div>\n                <div class=\"flex flex-col lg:flex-row lg:items-end justify-between gap-12\" data-kid=\"2-2-1-2-2\" data-name=\"card body container\">\n                    <div class=\"flex-1\" data-kid=\"2-2-1-2-2-1\" data-name=\"text content container\">\n                        <h4 class=\"serif text-5xl font-bold mb-6 leading-tight\" data-kid=\"2-2-1-2-2-1-1\" data-name=\"feature title\">\n                            Security Scan\n                        </h4>\n                        <p class=\"text-white/80 text-xl leading-relaxed max-w-md\" data-kid=\"2-2-1-2-2-1-2\" data-name=\"feature description\">\n                            Detect logic flaws, SQL injections, and vulnerable dependencies in your PRs with deep contextual analysis that understands your codebase.\n                        </p>\n                    </div>\n                    <div class=\"hidden lg:block w-32 h-32 border-4 border-white/20 rounded-full flex items-center justify-center font-serif text-3xl italic opacity-50 shrink-0\" data-kid=\"2-2-1-2-2-2\" data-name=\"security badge circular text\">\n                        SAFE\n                    </div>\n                </div>\n            </div>\n            <!-- Feature 3: Full Width / Different Style -->\n            <div class=\"feature-card col-span-12 bg-[var(--gold)] p-12 rounded-[32px] shadow-lg shadow-[var(--gold)]/10 mt-8 relative overflow-hidden\" data-kid=\"2-2-1-3\" data-name=\"pattern tracking feature card\">\n                <div class=\"relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-12\" data-kid=\"2-2-1-3-1\" data-name=\"card content wrapper\">\n                    <div class=\"max-w-xl\" data-kid=\"2-2-1-3-1-1\" data-name=\"text content container\">\n                        <div class=\"w-16 h-16 bg-white/40 rounded-2xl flex items-center justify-center mb-10\" data-kid=\"2-2-1-3-1-1-1\" data-name=\"feature icon container\">\n                            <svg class=\"w-10 h-10 text-[var(--ink)]\" data-kid=\"2-2-1-3-1-1-1-1\" data-name=\"pattern tracking icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                                <path d=\"M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v-1a1.5 1.5 0 013 0v1m0 0V11m0-5.5a1.5 1.5 0 013 0v3m0 0V11\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\">\n                                </path>\n                            </svg>\n                        </div>\n                        <h4 class=\"serif text-5xl font-bold mb-6 text-[var(--ink)] leading-tight\" data-kid=\"2-2-1-3-1-1-2\" data-name=\"feature title\">\n                            Pattern Tracking\n                        </h4>\n                        <p class=\"text-[var(--ink)]/70 text-xl leading-relaxed\" data-kid=\"2-2-1-3-1-1-3\" data-name=\"feature description\">\n                            Map your team's recurring blind spots and measure improvement over time. We don't just find bugs; we teach you how to avoid them forever.\n                        </p>\n                    </div>\n                    <div class=\"flex gap-4 opacity-40\" data-kid=\"2-2-1-3-1-2\" data-name=\"feature decorative bars container\">\n                        <div class=\"w-12 h-40 bg-[var(--ink)] rounded-full\" data-kid=\"2-2-1-3-1-2-1\" data-name=\"decorative bar one\">\n                        </div>\n                        <div class=\"w-12 h-56 bg-[var(--ink)] rounded-full -mt-8\" data-kid=\"2-2-1-3-1-2-2\" data-name=\"decorative bar two\">\n                        </div>\n                        <div class=\"w-12 h-32 bg-[var(--ink)] rounded-full mt-4\" data-kid=\"2-2-1-3-1-2-3\" data-name=\"decorative bar three\">\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Large Ribbon Flow Section -->\n    <section class=\"py-32 relative overflow-hidden flex items-center justify-center text-center\" data-kid=\"2-3\" data-name=\"ribbon flow call-to-action section\">\n        <svg class=\"absolute top-0 left-0 w-full h-full pointer-events-none z-0 opacity-15\" data-kid=\"2-3-1\" data-name=\"section background ribbon graphic\" preserveaspectratio=\"none\" viewbox=\"0 0 1440 400\">\n            <path d=\"M-100,300 C200,50 800,450 1200,100 C1400,-50 1600,200 1600,200\" fill=\"none\" stroke=\"var(--ink)\" stroke-linecap=\"round\" stroke-width=\"120\">\n            </path>\n        </svg>\n        <div class=\"relative z-10 px-6 max-w-2xl\" data-kid=\"2-3-2\" data-name=\"call-to-action content container\">\n            <h2 class=\"serif text-5xl font-bold mb-8 text-[var(--ink)]\" data-kid=\"2-3-2-1\" data-name=\"section headline\">\n                Ready to see\n                <br data-kid=\"2-3-2-1-1\" data-name=\"headline line break\"/>\n                what you're missing?\n            </h2>\n            <a class=\"pill-button bg-[var(--ink)] text-white hover:bg-[var(--ink-soft)] px-12 py-5 shadow-2xl\" data-kid=\"2-3-2-2\" data-name=\"call-to-action button\" href=\"/login\">\n                Analyze your first repository\n            </a>\n        </div>\n    </section>\n</main>\n<footer class=\"py-12 border-t border-[var(--ink)]/5 container mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-8 opacity-60\" data-kid=\"3\" data-name=\"footer bar\">\n    <div class=\"flex items-center gap-3\" data-kid=\"3-1\" data-name=\"brand identity container\">\n        <div class=\"w-6 h-6 rounded-full border border-[var(--ink)] flex items-center justify-center font-bold text-xs\" data-kid=\"3-1-1\" data-name=\"brand logo icon\">\n            C\n        </div>\n        <span class=\"font-bold text-sm tracking-tight text-[var(--ink)]\" data-kid=\"3-1-2\" data-name=\"brand name text\">\n            CodeLens\n        </span>\n    </div>\n    <div class=\"text-xs uppercase tracking-widest font-bold\" data-kid=\"3-2\" data-name=\"copyright notice text\">\n        © 2024 CodeLens Diagnostic Tool\n    </div>\n    <div class=\"flex gap-6\" data-kid=\"3-3\" data-name=\"footer navigation links wrapper\">\n        <a class=\"text-xs font-bold uppercase tracking-widest hover:text-[var(--coral)] transition-colors\" data-kid=\"3-3-1\" data-name=\"login footer link\" href=\"/login\">\n            Login\n        </a>\n        <a class=\"text-xs font-bold uppercase tracking-widest hover:text-[var(--coral)] transition-colors\" data-kid=\"3-3-2\" data-name=\"twitter footer link\" href=\"#\">\n            Twitter\n        </a>\n    </div>\n</footer>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<!-- CSS for DrawSVG replacement as we don't have the plugin by default often -->\n<style>\n    #heroRibbon {\n    stroke-dasharray: 2000;\n    stroke-dashoffset: 2000;\n  }\n</style>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n\n    window.addEventListener('DOMContentLoaded', () => {\n        const tl = gsap.timeline({ defaults: { ease: \"power4.out\", duration: 1.2 } });\n\n        tl.from(\".hero-content h1\", { y: 80, opacity: 0, delay: 0.4 })\n          .from(\".hero-content p\", { y: 40, opacity: 0 }, \"-=1\")\n          .from(\".hero-content .pill-button\", { y: 30, opacity: 0 }, \"-=1\")\n          .from(\".collage-grid .tile\", { \n            y: 40,\n            opacity: 0, \n            stagger: 0.1, \n            ease: \"power2.out\" \n          }, \"-=1\");\n\n        // Ribbon Draw Animation using stroke-dashoffset\n        gsap.to(\"#heroRibbon\", {\n            strokeDashoffset: 0,\n            scrollTrigger: {\n                trigger: \".hero-collage\",\n                start: \"top 70%\",\n                end: \"bottom center\",\n                scrub: 2\n            }\n        });\n\n        // Feature cards stagger\n        gsap.from(\".feature-card\", {\n            scrollTrigger: {\n                trigger: \".feature-card\",\n                start: \"top 85%\",\n            },\n            y: 50,\n            opacity: 0,\n            stagger: 0.2,\n            duration: 0.8,\n            ease: \"power2.out\"\n        });\n    });\n</script>\n",
      "comments": [],
      "created": "2026-08-02T17:20:22.978787+00:00",
      "modified": "2026-08-02T17:20:22.978787+00:00",
      "id": "var_bc1415621830"
    },
    "var_17cdcc888277": {
      "type": "variant",
      "label": "CodeLens Onboarding — GitHub",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 7700,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<div class=\"page-container min-h-screen bg-[#FAF7F2] font-sans text-[#241C2E] flex items-center justify-center p-4 md:p-8 overflow-x-clip\" data-kid=\"1\" data-name=\"page layout container\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;1,700&family=Inter:wght@400;500;600;700&display=swap');\n    @import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css');\n\n    :root {\n      --ink: #241C2E;\n      --cream: #FAF7F2;\n      --coral: #FF6B4A;\n      --gold: #F4B740;\n      --lav: #CDB8F7;\n      --sage: #8FBF6B;\n      --sky: #AEDDE4;\n      --pink: #F25C9A;\n      --orange: #F2884B;\n      --paper: #ffffff;\n    }\n\n    .font-serif { font-family: 'Playfair Display', serif; }\n    .font-sans { font-family: 'Inter', sans-serif; }\n\n    .collage-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      grid-template-rows: repeat(4, 1fr);\n    }\n\n    .tile-shadow { box-shadow: 0 12px 24px -6px rgba(0,0,0,0.12); }\n    \n    .ribbon-svg {\n      position: absolute;\n      inset: 0;\n      width: 100%;\n      height: 100%;\n      pointer-events: none;\n      z-index: 20;\n      overflow: visible;\n    }\n\n    .backdrop-site {\n      position: fixed;\n      inset: 0;\n      opacity: 0.2;\n      filter: blur(8px);\n      z-index: 0;\n      pointer-events: none;\n    }\n\n    .input-pill {\n      background: var(--cream);\n      border: 1px solid #e7e2da;\n      transition: all 0.3s ease;\n    }\n    .input-pill:focus-within {\n      border-color: var(--ink);\n      box-shadow: 0 0 0 2px rgba(36, 28, 46, 0.05);\n    }\n\n    .btn-primary {\n      background: var(--ink);\n      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n    }\n    .btn-primary:hover {\n      background: #3a3040;\n      transform: translateY(-2px);\n    }\n\n    .step-dot {\n      width: 6px;\n      height: 6px;\n      border-radius: 999px;\n      background: rgba(36, 28, 46, 0.15);\n    }\n    .step-dot.active {\n      width: 24px;\n      background: var(--ink);\n    }\n\n    /* GSAP targets will be set by JS, no pre-hidden states */\n    </style>\n    <!-- Blurred Background Motif -->\n    <div class=\"backdrop-site\" data-kid=\"1-1\" data-name=\"blurred background motif container\">\n        <div class=\"absolute top-10 left-10 w-64 h-64 bg-coral/20 rounded-full\" data-kid=\"1-1-1\" data-name=\"decorative background circle coral\">\n        </div>\n        <div class=\"absolute bottom-20 right-20 w-96 h-96 bg-sky/20 rounded-full\" data-kid=\"1-1-2\" data-name=\"decorative background circle sky\">\n        </div>\n        <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[80%] h-[80%] border-[40px] border-ink/5 rounded-full\" data-kid=\"1-1-3\" data-name=\"decorative background circle outline\">\n        </div>\n    </div>\n    <!-- Main Modal Container -->\n    <main class=\"relative z-10 w-full max-w-5xl bg-white rounded-[40px] shadow-[0_30px_60px_-15px_rgba(20,16,26,0.15)] overflow-hidden grid grid-cols-1 md:grid-cols-[44%_1fr] min-h-[660px]\" data-kid=\"1-2\" data-name=\"main modal card container\">\n        <!-- Close Action (Moved to left for better composition) -->\n        <button class=\"absolute top-8 left-8 z-50 bg-white shadow-lg px-4 py-2 rounded-full flex items-center gap-2 text-[10px] font-bold tracking-widest hover:scale-105 transition-transform cursor-pointer border border-ink/5\" data-kid=\"1-2-1\" data-name=\"close action button\">\n            <i class=\"fa-solid fa-xmark text-xs\" data-kid=\"1-2-1-1\" data-name=\"close x icon\">\n            </i>\n            CLOSE\n        </button>\n        <!-- Left Content Section -->\n        <section class=\"p-8 md:p-14 pt-20 md:pt-24 flex flex-col justify-between\" data-kid=\"1-2-2\" data-name=\"left content panel section\">\n            <div class=\"space-y-10\" data-kid=\"1-2-2-1\" data-name=\"main content wrapper\">\n                <!-- Brand & Progress -->\n                <div class=\"flex items-center justify-between\" data-kid=\"1-2-2-1-1\" data-name=\"brand and progress header\">\n                    <div class=\"flex items-center gap-3 font-bold text-xl tracking-tight\" data-kid=\"1-2-2-1-1-1\" data-name=\"brand name area\">\n                        <div class=\"w-9 h-9 rounded-full border-2 border-[var(--ink)] flex items-center justify-center\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"brand icon container\">\n                            <div class=\"w-4.5 h-4.5 bg-[var(--coral)] rotate-45\" data-kid=\"1-2-2-1-1-1-1-1\" data-name=\"brand logo diamond shape\">\n                            </div>\n                        </div>\n                        CodeLens\n                    </div>\n                    <nav aria-label=\"Progress\" class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-1-2\" data-name=\"progress navigation bar\">\n                        <div class=\"step-dot\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"inactive step dot\">\n                        </div>\n                        <div class=\"step-dot\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"inactive step dot\">\n                        </div>\n                        <div class=\"step-dot active\" data-kid=\"1-2-2-1-1-2-3\" data-name=\"active step dot\">\n                        </div>\n                    </nav>\n                </div>\n                <!-- Heading & Copy -->\n                <div class=\"space-y-6\" data-kid=\"1-2-2-1-2\" data-name=\"heading and description text wrapper\">\n                    <h1 class=\"font-serif text-[46px] leading-[1.1] font-bold tracking-tight text-[var(--ink)]\" data-kid=\"1-2-2-1-2-1\" data-name=\"hero headline text\">\n                        Bring the code you already have.\n                    </h1>\n                    <p class=\"text-[#6f6a72] text-lg leading-relaxed max-w-[95%]\" data-kid=\"1-2-2-1-2-2\" data-name=\"introductory description text\">\n                        Paste your GitHub repository URL below. We'll prefill your workspace by fetching your source code for immediate analysis.\n                    </p>\n                </div>\n                <!-- Action Area -->\n                <div class=\"action-block space-y-4\" data-kid=\"1-2-2-1-3\" data-name=\"action block wrapper\">\n                    <div class=\"input-pill flex items-center px-6 h-[72px] rounded-[24px]\" data-kid=\"1-2-2-1-3-1\" data-name=\"repository input field wrapper\">\n                        <input class=\"flex-1 bg-transparent border-none outline-hidden text-lg font-medium placeholder:text-ink/30 truncate\" data-kid=\"1-2-2-1-3-1-1\" data-name=\"repository url input field\" placeholder=\"https://github.com/you/repo\" type=\"text\"/>\n                        <div class=\"w-10 h-10 rounded-full bg-white flex items-center justify-center border border-ink/10 shadow-xs shrink-0\" data-kid=\"1-2-2-1-3-1-2\" data-name=\"github icon container\">\n                            <i class=\"fa-brands fa-github text-[var(--ink)] text-lg\" data-kid=\"1-2-2-1-3-1-2-1\" data-name=\"github logo icon\">\n                            </i>\n                        </div>\n                    </div>\n                    <button class=\"btn-primary w-full h-[72px] rounded-[24px] text-white font-bold tracking-[0.2em] text-xs cursor-pointer shadow-xl\" data-kid=\"1-2-2-1-3-2\" data-name=\"primary action button\">\n                        LET'S GO\n                    </button>\n                </div>\n            </div>\n            <!-- Navigation Control -->\n            <footer data-kid=\"1-2-2-2\" data-name=\"navigation footer\">\n                <button class=\"flex items-center gap-3 text-[#6f6a72] font-bold text-xs tracking-widest hover:text-[var(--ink)] transition-colors group cursor-pointer\" data-kid=\"1-2-2-2-1\" data-name=\"back navigation button\">\n                    <i class=\"fa-solid fa-arrow-left transition-transform group-hover:-translate-x-1\" data-kid=\"1-2-2-2-1-1\" data-name=\"left arrow icon\">\n                    </i>\n                    BACK\n                </button>\n            </footer>\n        </section>\n        <!-- Right Collage Section -->\n        <section class=\"relative bg-[var(--cream)] overflow-hidden collage-grid\" data-kid=\"1-2-3\" data-name=\"right collage section\">\n            <!-- Tile 1: GitHub -->\n            <div class=\"tile bg-[var(--sky)] flex items-center justify-center p-8 border-b border-r border-white/20\" data-kid=\"1-2-3-1\" data-name=\"github tile\">\n                <div class=\"w-20 h-20 bg-white rounded-2xl shadow-xl flex items-center justify-center text-4xl\" data-kid=\"1-2-3-1-1\" data-name=\"github icon tile container\">\n                    <i class=\"fa-brands fa-github text-[var(--ink)]\" data-kid=\"1-2-3-1-1-1\" data-name=\"github logo icon\">\n                    </i>\n                </div>\n            </div>\n            <!-- Tile 2: Slogan -->\n            <div class=\"tile bg-[var(--coral)] text-white p-8 flex items-end border-b border-r border-white/20\" data-kid=\"1-2-3-2\" data-name=\"slogan tile\">\n                <div class=\"font-serif text-2xl font-bold leading-[1.1]\" data-kid=\"1-2-3-2-1\" data-name=\"slogan text\">\n                    Real-time\n                    <br data-kid=\"1-2-3-2-1-1\" data-name=\"line break\"/>\n                    Analysis\n                    <br data-kid=\"1-2-3-2-1-2\" data-name=\"line break\"/>\n                    Starts here.\n                </div>\n            </div>\n            <!-- Tile 3: Code Card -->\n            <div class=\"tile bg-[var(--lav)] flex items-center justify-center p-8 border-b border-white/20\" data-kid=\"1-2-3-3\" data-name=\"code card tile\">\n                <div class=\"bg-white p-5 rounded-xl shadow-2xl -rotate-6 transform scale-110\" data-kid=\"1-2-3-3-1\" data-name=\"floating code card element\">\n                    <div class=\"w-12 h-2 bg-[var(--lav)] rounded-full mb-3 opacity-30\" data-kid=\"1-2-3-3-1-1\" data-name=\"code card line placeholder\">\n                    </div>\n                    <div class=\"w-8 h-2 bg-[var(--lav)] rounded-full opacity-30\" data-kid=\"1-2-3-3-1-2\" data-name=\"code card line placeholder\">\n                    </div>\n                    <div class=\"mt-4 font-serif font-black text-xl text-[var(--lav-ink)]\" data-kid=\"1-2-3-3-1-3\" data-name=\"code directory text\">\n                        SRC/\n                    </div>\n                </div>\n            </div>\n            <!-- Tile 4: URL Label -->\n            <div class=\"tile bg-[var(--sage)] flex items-center justify-center p-8 border-b border-r border-white/20\" data-kid=\"1-2-3-4\" data-name=\"url label tile\">\n                <div class=\"bg-[var(--ink)] py-3 px-6 rounded-full text-white text-[10px] font-black tracking-[0.15em]\" data-kid=\"1-2-3-4-1\" data-name=\"url label text\">\n                    REPOSITORY URL\n                </div>\n            </div>\n            <!-- Tile 5: Fetch Arrow -->\n            <div class=\"tile bg-[var(--gold)] flex items-center justify-center p-8 border-b border-r border-white/20\" data-kid=\"1-2-3-5\" data-name=\"fetch arrow tile\">\n                <div class=\"w-32 h-32 bg-white/20 rounded-full flex items-center justify-center shadow-inner\" data-kid=\"1-2-3-5-1\" data-name=\"arrow circle container\">\n                    <i class=\"fa-solid fa-arrow-down-long text-7xl text-[var(--gold-ink)] opacity-50 transform rotate-[-45deg]\" data-kid=\"1-2-3-5-1-1\" data-name=\"down arrow icon\">\n                    </i>\n                </div>\n            </div>\n            <!-- Tile 6: Ready Check -->\n            <div class=\"tile bg-white flex items-center justify-center p-8 border-b border-white/20\" data-kid=\"1-2-3-6\" data-name=\"ready check tile\">\n                <div class=\"relative\" data-kid=\"1-2-3-6-1\" data-name=\"check card container\">\n                    <div class=\"w-28 h-36 bg-gradient-to-br from-[#8FBF6B] to-[#1c5c46] rounded-xl shadow-[0_20px_40px_-10px_rgba(40,100,60,0.3)] flex flex-col justify-end p-5 rotate-3 transform\" data-kid=\"1-2-3-6-1-1\" data-name=\"analysis ready card\">\n                        <div class=\"text-[9px] text-white/50 font-black tracking-widest mb-1 uppercase\" data-kid=\"1-2-3-6-1-1-1\" data-name=\"analysis label\">\n                            Analysis\n                        </div>\n                        <div class=\"text-sm text-white font-serif font-black leading-tight italic\" data-kid=\"1-2-3-6-1-1-2\" data-name=\"analysis status text\">\n                            Ready to\n                            <br data-kid=\"1-2-3-6-1-1-2-1\" data-name=\"line break\"/>\n                            Analyze.\n                        </div>\n                    </div>\n                    <div class=\"absolute -top-3 -right-3 w-11 h-11 bg-white rounded-full flex items-center justify-center shadow-2xl z-10 border-4 border-[var(--cream)]\" data-kid=\"1-2-3-6-1-2\" data-name=\"checkmark circle container\">\n                        <i class=\"fa-solid fa-check text-[#8FBF6B] text-lg\" data-kid=\"1-2-3-6-1-2-1\" data-name=\"checkmark icon\">\n                        </i>\n                    </div>\n                </div>\n            </div>\n            <!-- Tile 7: Code Lines -->\n            <div class=\"tile bg-[var(--pink)] flex items-center justify-center p-8 border-b border-r border-white/20\" data-kid=\"1-2-3-7\" data-name=\"code lines tile\">\n                <div class=\"flex flex-col gap-2 w-full max-w-[80px]\" data-kid=\"1-2-3-7-1\" data-name=\"code lines container\">\n                    <div class=\"h-1.5 w-full bg-white/30 rounded-full\" data-kid=\"1-2-3-7-1-1\" data-name=\"code line\">\n                    </div>\n                    <div class=\"h-1.5 w-3/4 bg-white/30 rounded-full\" data-kid=\"1-2-3-7-1-2\" data-name=\"code line\">\n                    </div>\n                    <div class=\"h-1.5 w-5/6 bg-white/30 rounded-full\" data-kid=\"1-2-3-7-1-3\" data-name=\"code line\">\n                    </div>\n                    <div class=\"h-1.5 w-1/2 bg-white/30 rounded-full\" data-kid=\"1-2-3-7-1-4\" data-name=\"code line\">\n                    </div>\n                </div>\n            </div>\n            <!-- Tile 8: Processing -->\n            <div class=\"tile bg-[var(--orange)] flex items-center justify-center p-8 border-b border-r border-white/20\" data-kid=\"1-2-3-8\" data-name=\"processing animation tile\">\n                <div class=\"flex items-center gap-1.5\" data-kid=\"1-2-3-8-1\" data-name=\"animation bars container\">\n                    <div class=\"w-1.5 h-6 bg-white/40 rounded-full animate-bounce\" data-kid=\"1-2-3-8-1-1\" data-name=\"bouncing bar 1\">\n                    </div>\n                    <div class=\"w-1.5 h-10 bg-white rounded-full animate-bounce [animation-delay:0.1s]\" data-kid=\"1-2-3-8-1-2\" data-name=\"bouncing bar 2\">\n                    </div>\n                    <div class=\"w-1.5 h-8 bg-white/60 rounded-full animate-bounce [animation-delay:0.2s]\" data-kid=\"1-2-3-8-1-3\" data-name=\"bouncing bar 3\">\n                    </div>\n                </div>\n            </div>\n            <!-- Tile 9: Text -->\n            <div class=\"tile bg-white flex flex-col justify-center items-center text-center p-8 border-b border-white/20\" data-kid=\"1-2-3-9\" data-name=\"done text tile\">\n                <div class=\"font-serif italic text-2xl font-bold text-[var(--ink)]\" data-kid=\"1-2-3-9-1\" data-name=\"done headline\">\n                    Done.\n                </div>\n                <div class=\"text-[8px] font-black tracking-[0.2em] opacity-40 uppercase mt-1\" data-kid=\"1-2-3-9-2\" data-name=\"final step subtext\">\n                    Final Step\n                </div>\n            </div>\n            <!-- Tile 10: Spacer -->\n            <div class=\"tile bg-[var(--sky)]/30 border-r border-white/20\" data-kid=\"1-2-3-10\" data-name=\"spacer tile\">\n            </div>\n            <!-- Tile 11: Circle Pulse -->\n            <div class=\"tile bg-[var(--lav)] flex items-center justify-center p-8 border-r border-white/20\" data-kid=\"1-2-3-11\" data-name=\"circle pulse tile\">\n                <div class=\"w-16 h-16 rounded-full border border-white/40 flex items-center justify-center\" data-kid=\"1-2-3-11-1\" data-name=\"pulse ring container\">\n                    <div class=\"w-10 h-10 bg-white rounded-full shadow-lg\" data-kid=\"1-2-3-11-1-1\" data-name=\"pulse center dot\">\n                    </div>\n                </div>\n            </div>\n            <!-- Tile 12: Spacer -->\n            <div class=\"tile bg-[var(--sage)]/30\" data-kid=\"1-2-3-12\" data-name=\"spacer tile\">\n            </div>\n            <!-- Ribbon Overlay -->\n            <svg class=\"ribbon-svg\" data-dynamic=\"true\" data-kid=\"1-2-3-13\" data-name=\"ribbon overlay svg\" data-reason=\"stroke dashoffset animated by gsap script\" preserveaspectratio=\"none\" viewbox=\"0 0 600 800\">\n                <path d=\"M650,-50 C600,100 550,150 400,300 C250,450 350,600 200,700 C100,750 0,800 -100,900\" fill=\"none\" id=\"ribbonPath\" opacity=\"0.95\" stroke=\"var(--ink)\" stroke-linecap=\"round\" stroke-width=\"50\">\n                </path>\n            </svg>\n        </section>\n    </main>\n    <!-- Scripts -->\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n    </script>\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n      // Tiles entrance\n      gsap.from('.tile', {\n        scale: 0.9,\n        opacity: 0,\n        y: 20,\n        duration: 0.8,\n        stagger: {\n          amount: 0.8,\n          grid: [4, 3],\n          from: \"random\"\n        },\n        ease: \"back.out(1.7)\"\n      });\n\n      // Ribbon animation\n      const path = document.querySelector('#ribbonPath');\n      const length = path.getTotalLength();\n      \n      gsap.set(path, {\n        strokeDasharray: length,\n        strokeDashoffset: length\n      });\n\n      gsap.to(path, {\n        strokeDashoffset: 0,\n        duration: 2.5,\n        delay: 0.5,\n        ease: \"power2.inOut\"\n      });\n\n      // Left panel elements\n      gsap.from('.action-block, header, .space-y-6 h1, .space-y-6 p, footer', {\n        opacity: 0,\n        x: -30,\n        duration: 1,\n        stagger: 0.1,\n        ease: \"power3.out\"\n      });\n    });\n    </script>\n</div>\n",
      "comments": [],
      "created": "2026-08-02T17:20:22.915340+00:00",
      "modified": "2026-08-02T17:20:22.915340+00:00",
      "id": "var_17cdcc888277"
    },
    "var_a070684b9dd7": {
      "type": "variant",
      "label": "CodeLens App — Empty",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 9240,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');\n\n  :root {\n    --cream: #FAF7F2;\n    --ink: #241C2E;\n    --ink-muted: #5e5962;\n    --ink-soft: #8a848f;\n    --line: #E7E2DA;\n    --paper: #ffffff;\n    \n    --coral: #FF6B4A;\n    --gold: #F4B740;\n    --lavender: #CDB8F7;\n    --sage: #8FBF6B;\n    --sky: #AEDDE4;\n    --pink: #F25C9A;\n    --orange: #F2884B;\n\n    --radius-xl: 16px; /* Sharper */\n    --radius-lg: 12px;\n    --radius-md: 8px;\n    --radius-sm: 4px;\n  }\n\n  body {\n    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;\n    background-color: var(--cream);\n    color: var(--ink);\n    overflow-x: clip;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .font-serif { font-family: 'Georgia', 'Times New Roman', serif; }\n  .font-mono { font-family: 'JetBrains Mono', monospace; }\n\n  /* Custom Scrollbar */\n  ::-webkit-scrollbar { width: 6px; }\n  ::-webkit-scrollbar-track { background: transparent; }\n  ::-webkit-scrollbar-thumb { background: var(--line); border-radius: 10px; }\n  ::-webkit-scrollbar-thumb:hover { background: var(--ink-muted); }\n\n  /* Glass Effects */\n  .glass {\n    background: rgba(255, 255, 255, 0.4);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.2);\n  }\n\n  .shadow-soft {\n    box-shadow: 0 10px 30px -10px rgba(36, 28, 46, 0.08);\n  }\n\n  .shadow-deep {\n    box-shadow: 0 40px 80px -20px rgba(36, 28, 46, 0.15);\n  }\n\n  /* Ribbon Traces */\n  .trace-container {\n    position: fixed;\n    inset: 0;\n    pointer-events: none;\n    z-index: 0;\n    overflow: hidden;\n  }\n\n  /* Interaction Styles */\n  .input-focus:focus-within {\n    border-color: var(--lavender);\n    box-shadow: 0 0 0 4px rgba(205, 184, 247, 0.2);\n  }\n\n  .analyze-btn {\n    position: relative;\n    overflow: hidden;\n    transition: background 0.2s ease, transform 0.1s ease;\n  }\n  .analyze-btn:hover {\n    background: var(--ink-muted);\n  }\n  .analyze-btn:active {\n    transform: translateY(0);\n  }\n\n  /* Toggle Button Logic */\n  .toggle-active {\n    background: var(--ink);\n    color: white;\n    box-shadow: 0 4px 12px rgba(36, 28, 46, 0.2);\n  }\n\n  /* Animation Overrides */\n  .gsap-reveal { opacity: 1; }\n</style>\n<div class=\"trace-container\" data-kid=\"1\" data-name=\"ribbon trace background container\" id=\"traces\">\n    <svg class=\"w-full h-full opacity-10\" data-kid=\"1-1\" data-name=\"decorative ribbon trace svg\" preserveaspectratio=\"none\" viewbox=\"0 0 1440 1000\">\n        <path d=\"M1440,100 C1100,200 1300,450 1000,600 C700,750 900,900 400,950 C100,980 0,900 -100,1000\" fill=\"none\" id=\"mainTrace\" stroke=\"var(--ink)\" stroke-linecap=\"round\" stroke-width=\"60\">\n        </path>\n        <path d=\"M1440,150 C1200,250 1300,500 1100,650\" fill=\"none\" stroke=\"var(--coral)\" stroke-linecap=\"round\" stroke-width=\"8\">\n        </path>\n        <path d=\"M-50,800 C150,850 300,700 450,850\" fill=\"none\" stroke=\"var(--gold)\" stroke-linecap=\"round\" stroke-width=\"12\">\n        </path>\n    </svg>\n</div>\n<div class=\"relative z-10 flex flex-col h-screen overflow-hidden\" data-kid=\"2\" data-name=\"main application interface container\">\n    <!-- Header -->\n    <header class=\"h-20 shrink-0 border-b border-[var(--line)] bg-white/70 backdrop-blur-xl flex items-center justify-between px-8\" data-kid=\"2-1\" data-name=\"header bar\">\n        <div class=\"flex items-center gap-4\" data-kid=\"2-1-1\" data-name=\"brand logo area\">\n            <div class=\"w-10 h-10 rounded-xl bg-[var(--ink)] flex items-center justify-center rotate-3 shadow-lg\" data-kid=\"2-1-1-1\" data-name=\"logo icon container\">\n                <svg class=\"w-6 h-6 text-white\" data-kid=\"2-1-1-1-1\" data-name=\"search magnifying glass icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                    <circle cx=\"11\" cy=\"11\" r=\"8\">\n                    </circle>\n                    <path d=\"m21 21-4.3-4.3\">\n                    </path>\n                    <path d=\"M11 8v6\">\n                    </path>\n                    <path d=\"M8 11h6\">\n                    </path>\n                </svg>\n            </div>\n            <div data-kid=\"2-1-1-2\" data-name=\"brand name and version group\">\n                <h1 class=\"font-bold text-xl tracking-tight leading-none\" data-kid=\"2-1-1-2-1\" data-name=\"app name headline\">\n                    CodeLens\n                </h1>\n                <span class=\"text-[10px] uppercase font-black tracking-widest text-[var(--ink-muted)]\" data-kid=\"2-1-1-2-2\" data-name=\"app version tag\">\n                    Beta v0.4.2\n                </span>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-6\" data-kid=\"2-1-2\" data-name=\"user profile section\">\n            <div class=\"h-8 w-[1px] bg-[var(--line)]\" data-kid=\"2-1-2-1\" data-name=\"separator line\">\n            </div>\n            <div class=\"flex items-center gap-3 bg-[var(--cream)] p-1.5 pr-4 rounded-full border border-[var(--line)]\" data-kid=\"2-1-2-2\" data-name=\"user profile info card\">\n                <img alt=\"Maya Chen\" class=\"w-8 h-8 rounded-full object-cover ring-2 ring-white\" data-kid=\"2-1-2-2-1\" data-name=\"user avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/150?u=mayachen\"/>\n                <div class=\"flex flex-col\" data-kid=\"2-1-2-2-2\" data-name=\"user profile details group\">\n                    <span class=\"text-sm font-bold leading-none\" data-kid=\"2-1-2-2-2-1\" data-name=\"user full name\">\n                        Maya Chen\n                    </span>\n                    <span class=\"text-[10px] font-medium opacity-50\" data-kid=\"2-1-2-2-2-2\" data-name=\"user job title\">\n                        Enterprise Developer\n                    </span>\n                </div>\n            </div>\n            <button class=\"text-xs font-bold uppercase tracking-widest text-[var(--ink-muted)] hover:text-[var(--ink)] transition-colors\" data-kid=\"2-1-2-3\" data-name=\"sign out button\">\n                Sign out\n            </button>\n        </div>\n    </header>\n    <div class=\"flex flex-1 overflow-hidden\" data-kid=\"2-2\" data-name=\"main layout workspace\">\n        <!-- Left Sidebar: History -->\n        <aside class=\"w-72 shrink-0 border-r border-[var(--line)] flex flex-col bg-[var(--cream)]\" data-kid=\"2-2-1\" data-name=\"history sidebar\">\n            <div class=\"p-6 pb-2 flex items-center justify-between\" data-kid=\"2-2-1-1\" data-name=\"sidebar header area\">\n                <h2 class=\"font-serif text-xl\" data-kid=\"2-2-1-1-1\" data-name=\"history section title\">\n                    Recent analyses\n                </h2>\n                <button class=\"group flex items-center gap-1.5\" data-kid=\"2-2-1-1-2\" data-name=\"clear history button\">\n                    <span class=\"text-[10px] font-bold uppercase tracking-widest text-[var(--ink-soft)] group-hover:text-[var(--ink)] transition-colors\" data-kid=\"2-2-1-1-2-1\" data-name=\"clear button text\">\n                        Clear\n                    </span>\n                </button>\n            </div>\n            <div class=\"flex-1 flex flex-col p-6 gap-6 pt-10\" data-kid=\"2-2-1-2\" data-name=\"empty state content area\">\n                <div class=\"flex flex-col gap-4 text-left\" data-kid=\"2-2-1-2-1\" data-name=\"empty history icon and text container\">\n                    <div class=\"w-10 h-10 rounded-lg bg-[var(--line)] flex items-center justify-center\" data-kid=\"2-2-1-2-1-1\" data-name=\"empty state icon container\">\n                        <svg class=\"w-5 h-5 text-[var(--ink-soft)]\" data-kid=\"2-2-1-2-1-1-1\" data-name=\"archive history empty icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                            <path d=\"M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\">\n                            </path>\n                        </svg>\n                    </div>\n                    <div data-kid=\"2-2-1-2-1-2\" data-name=\"empty state message group\">\n                        <p class=\"font-serif text-lg leading-snug mb-1 text-[var(--ink)]\" data-kid=\"2-2-1-2-1-2-1\" data-name=\"empty history title\">\n                            No history yet.\n                        </p>\n                        <p class=\"text-xs text-[var(--ink-soft)] leading-relaxed\" data-kid=\"2-2-1-2-1-2-2\" data-name=\"empty history description\">\n                            Your scan logs will populate this list as you analyze new repositories.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mt-4 pt-4 border-t border-[var(--line)]\" data-kid=\"2-2-1-2-2\" data-name=\"empty history skeleton list\">\n                    <div class=\"flex flex-col gap-2 opacity-30\" data-kid=\"2-2-1-2-2-1\" data-name=\"skeleton rows container\">\n                        <div class=\"h-8 w-full bg-[var(--line)] rounded-sm\" data-kid=\"2-2-1-2-2-1-1\" data-name=\"skeleton row 1\">\n                        </div>\n                        <div class=\"h-8 w-3/4 bg-[var(--line)] rounded-sm\" data-kid=\"2-2-1-2-2-1-2\" data-name=\"skeleton row 2\">\n                        </div>\n                        <div class=\"h-8 w-5/6 bg-[var(--line)] rounded-sm\" data-kid=\"2-2-1-2-2-1-3\" data-name=\"skeleton row 3\">\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"p-6\" data-kid=\"2-2-1-3\" data-name=\"quick tip container\">\n                <div class=\"bg-white rounded-[var(--radius-lg)] border border-[var(--line)] p-4 flex items-center gap-4 shadow-sm\" data-kid=\"2-2-1-3-1\" data-name=\"quick tip card\">\n                    <div class=\"w-10 h-10 rounded-xl bg-[var(--sky)] flex items-center justify-center shrink-0\" data-kid=\"2-2-1-3-1-1\" data-name=\"quick tip icon container\">\n                        <svg class=\"w-5 h-5\" data-kid=\"2-2-1-3-1-1-1\" data-name=\"lightning bolt tip icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                            <path d=\"M13 10V3L4 14h7v7l9-11h-7z\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\">\n                            </path>\n                        </svg>\n                    </div>\n                    <div class=\"flex flex-col\" data-kid=\"2-2-1-3-1-2\" data-name=\"quick tip text group\">\n                        <span class=\"text-[10px] font-bold uppercase tracking-wider\" data-kid=\"2-2-1-3-1-2-1\" data-name=\"quick tip label\">\n                            Quick Tip\n                        </span>\n                        <span class=\"text-xs opacity-60\" data-kid=\"2-2-1-3-1-2-2\" data-name=\"quick tip message\">\n                            Paste a GitHub repo for full scan.\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </aside>\n        <!-- Center: Workspace -->\n        <main class=\"flex-1 overflow-y-auto p-12 lg:p-16 flex flex-col items-center\" data-kid=\"2-2-2\" data-name=\"workspace center panel\">\n            <div class=\"max-w-4xl w-full flex flex-col gap-10 workspace-content\" data-kid=\"2-2-2-1\" data-name=\"workspace interaction content\">\n                <!-- Controls Header -->\n                <div class=\"grid grid-cols-1 md:grid-cols-12 gap-6 items-end\" data-kid=\"2-2-2-1-1\" data-name=\"controls header grid\">\n                    <div class=\"md:col-span-7 flex flex-col gap-2.5\" data-kid=\"2-2-2-1-1-1\" data-name=\"connect source input group\">\n                        <label class=\"text-[10px] font-black uppercase tracking-[0.2em] text-[var(--ink-muted)] ml-1\" data-kid=\"2-2-2-1-1-1-1\" data-name=\"source input label\">\n                            Connect Source\n                        </label>\n                        <div class=\"relative group input-focus rounded-2xl border border-[var(--line)] bg-white shadow-soft transition-all duration-300\" data-kid=\"2-2-2-1-1-1-2\" data-name=\"source input wrapper\">\n                            <div class=\"absolute left-4 top-1/2 -translate-y-1/2 text-[var(--ink-muted)] group-focus-within:text-[var(--ink)]\" data-kid=\"2-2-2-1-1-1-2-1\" data-name=\"github icon container\">\n                                <svg class=\"w-5 h-5\" data-kid=\"2-2-2-1-1-1-2-1-1\" data-name=\"github logo icon\" fill=\"currentColor\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12\">\n                                    </path>\n                                </svg>\n                            </div>\n                            <input class=\"w-full h-14 pl-12 pr-4 bg-transparent outline-hidden font-medium text-sm placeholder:text-[var(--ink-soft)]\" data-kid=\"2-2-2-1-1-1-2-2\" data-name=\"source repository url input\" placeholder=\"https://github.com/maya/awesome-app\" type=\"text\"/>\n                        </div>\n                    </div>\n                    <div class=\"md:col-span-5 flex flex-col gap-2.5\" data-kid=\"2-2-2-1-1-2\" data-name=\"detection focus selector group\">\n                        <label class=\"text-[10px] font-black uppercase tracking-[0.2em] text-[var(--ink-muted)] ml-1\" data-kid=\"2-2-2-1-1-2-1\" data-name=\"detection focus label\">\n                            Detection Focus\n                        </label>\n                        <div class=\"h-14 p-1 rounded-[var(--radius-lg)] border border-[var(--line)] bg-white shadow-soft flex gap-1\" data-kid=\"2-2-2-1-1-2-2\" data-name=\"toggle button group\">\n                            <button class=\"flex-1 rounded-lg text-xs font-bold tracking-wide transition-all toggle-active flex items-center justify-center gap-2\" data-kid=\"2-2-2-1-1-2-2-1\" data-name=\"algo focus toggle button\">\n                                <svg class=\"w-3.5 h-3.5\" data-kid=\"2-2-2-1-1-2-2-1-1\" data-name=\"algo icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\">\n                                    </path>\n                                </svg>\n                                Algo\n                            </button>\n                            <button class=\"flex-1 rounded-lg text-xs font-bold tracking-wide text-[var(--ink-soft)] hover:text-[var(--ink)] transition-all flex items-center justify-center gap-2\" data-kid=\"2-2-2-1-1-2-2-2\" data-name=\"security focus toggle button\">\n                                <svg class=\"w-3.5 h-3.5\" data-kid=\"2-2-2-1-1-2-2-2-1\" data-name=\"security icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\">\n                                    </path>\n                                </svg>\n                                Security\n                            </button>\n                        </div>\n                    </div>\n                </div>\n                <!-- Code Workspace -->\n                <div class=\"flex flex-col gap-2.5\" data-kid=\"2-2-2-1-2\" data-name=\"snippet editor section\">\n                    <label class=\"text-[10px] font-black uppercase tracking-[0.2em] text-[var(--ink-muted)] ml-1\" data-kid=\"2-2-2-1-2-1\" data-name=\"snippet label\">\n                        Direct Snippet Input\n                    </label>\n                    <div class=\"relative group shadow-deep rounded-[var(--radius-xl)] overflow-hidden border border-[var(--line)] bg-white\" data-kid=\"2-2-2-1-2-2\" data-name=\"snippet editor container\">\n                        <!-- Code Header Decor -->\n                        <div class=\"h-10 bg-[var(--paper)] border-b border-[var(--line)] px-6 flex items-center justify-between\" data-kid=\"2-2-2-1-2-2-1\" data-name=\"snippet header decoration\">\n                            <div class=\"flex gap-1.5\" data-kid=\"2-2-2-1-2-2-1-1\" data-name=\"editor traffic light buttons\">\n                                <div class=\"w-2.5 h-2.5 rounded-full bg-[var(--coral)]/30\" data-kid=\"2-2-2-1-2-2-1-1-1\" data-name=\"red decorator dot\">\n                                </div>\n                                <div class=\"w-2.5 h-2.5 rounded-full bg-[var(--gold)]/30\" data-kid=\"2-2-2-1-2-2-1-1-2\" data-name=\"yellow decorator dot\">\n                                </div>\n                                <div class=\"w-2.5 h-2.5 rounded-full bg-[var(--sage)]/30\" data-kid=\"2-2-2-1-2-2-1-1-3\" data-name=\"green decorator dot\">\n                                </div>\n                            </div>\n                            <span class=\"text-[9px] font-bold uppercase tracking-widest text-[var(--ink-muted)]\" data-kid=\"2-2-2-1-2-2-1-2\" data-name=\"file name text\">\n                                main.js\n                            </span>\n                        </div>\n                        <textarea class=\"w-full h-96 p-8 font-mono text-sm leading-relaxed resize-none bg-transparent outline-hidden text-[var(--ink)] placeholder:text-[var(--ink-soft)]\" data-kid=\"2-2-2-1-2-2-2\" data-name=\"code input textarea\" placeholder=\"/**\n * Paste your code here to begin analysis.\n * CodeLens detects time complexity issues, \n * memory leaks, and logic vulnerabilities.\n */\n\nasync function fetchUserData(userId) {\n  const response = await db.query(\n    'SELECT * FROM users WHERE id = ' + userId\n  );\n  return response.rows[0];\n}\"></textarea>\n                        <div class=\"absolute bottom-8 right-8 z-20\" data-kid=\"2-2-2-1-2-2-3\" data-name=\"analyze call-to-action button container\">\n                            <button class=\"analyze-btn bg-[var(--ink)] text-white px-10 h-14 rounded-full font-bold text-sm tracking-widest uppercase flex items-center gap-3\" data-kid=\"2-2-2-1-2-2-3-1\" data-name=\"analyze code button\">\n                                <span data-kid=\"2-2-2-1-2-2-3-1-1\" data-name=\"analyze button label\">\n                                    Analyze Code\n                                </span>\n                                <svg class=\"w-4 h-4\" data-kid=\"2-2-2-1-2-2-3-1-2\" data-name=\"arrow right icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M5 12h14M12 5l7 7-7 7\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                    </path>\n                                </svg>\n                            </button>\n                        </div>\n                        <!-- Subtle Grid Background for Textarea -->\n                        <div class=\"absolute inset-0 pointer-events-none opacity-[0.03] z-0\" data-kid=\"2-2-2-1-2-2-4\" data-name=\"editor background grid texture\" style=\"background-image: radial-gradient(var(--ink) 1px, transparent 0); background-size: 24px 24px;\">\n                        </div>\n                    </div>\n                </div>\n                <!-- Extra Bottom Flair -->\n                <div class=\"flex justify-center items-center gap-8 opacity-20 py-4\" data-kid=\"2-2-2-1-3\" data-name=\"footer flair indicators\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-2-2-1-3-1\" data-name=\"complexity scan status indicator\">\n                        <div class=\"w-1.5 h-1.5 rounded-full bg-[var(--coral)]\" data-kid=\"2-2-2-1-3-1-1\" data-name=\"complexity dot\">\n                        </div>\n                        <span class=\"text-[9px] font-bold uppercase tracking-widest\" data-kid=\"2-2-2-1-3-1-2\" data-name=\"complexity label\">\n                            Complexity Scan\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-2-2-1-3-2\" data-name=\"logic flow status indicator\">\n                        <div class=\"w-1.5 h-1.5 rounded-full bg-[var(--gold)]\" data-kid=\"2-2-2-1-3-2-1\" data-name=\"logic dot\">\n                        </div>\n                        <span class=\"text-[9px] font-bold uppercase tracking-widest\" data-kid=\"2-2-2-1-3-2-2\" data-name=\"logic label\">\n                            Logic Flow\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"2-2-2-1-3-3\" data-name=\"security audit status indicator\">\n                        <div class=\"w-1.5 h-1.5 rounded-full bg-[var(--sage)]\" data-kid=\"2-2-2-1-3-3-1\" data-name=\"security dot\">\n                        </div>\n                        <span class=\"text-[9px] font-bold uppercase tracking-widest\" data-kid=\"2-2-2-1-3-3-2\" data-name=\"security label\">\n                            Security Audit\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </main>\n        <!-- Right Sidebar: Diagnosis -->\n        <aside class=\"w-80 shrink-0 border-l border-[var(--line)] bg-[var(--cream)] p-6 flex flex-col gap-10\" data-kid=\"2-2-3\" data-name=\"diagnosis sidebar\">\n            <!-- Diagnosis Section -->\n            <section class=\"flex flex-col gap-4\" data-kid=\"2-2-3-1\" data-name=\"diagnosis section\">\n                <h2 class=\"font-serif text-xl\" data-kid=\"2-2-3-1-1\" data-name=\"diagnosis section title\">\n                    Diagnosis\n                </h2>\n                <div class=\"relative group\" data-kid=\"2-2-3-1-2\" data-name=\"diagnosis status placeholder card\">\n                    <div class=\"p-6 rounded-[var(--radius-lg)] border-2 border-dashed border-[var(--line)] bg-[var(--paper)] flex flex-col gap-4 transition-colors group-hover:border-[var(--lavender)]\" data-kid=\"2-2-3-1-2-1\" data-name=\"placeholder inner content\">\n                        <div class=\"w-8 h-8 rounded-lg bg-[var(--lavender)]/20 flex items-center justify-center text-[var(--ink)]\" data-kid=\"2-2-3-1-2-1-1\" data-name=\"placeholder icon container\">\n                            <svg class=\"w-4 h-4\" data-kid=\"2-2-3-1-2-1-1-1\" data-name=\"info circle icon\" fill=\"none\" stroke=\"currentColor\" viewbox=\"0 0 24 24\">\n                                <path d=\"M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\">\n                                </path>\n                            </svg>\n                        </div>\n                        <div class=\"flex flex-col gap-1.5\" data-kid=\"2-2-3-1-2-1-2\" data-name=\"placeholder message group\">\n                            <p class=\"text-sm font-bold leading-tight\" data-kid=\"2-2-3-1-2-1-2-1\" data-name=\"placeholder title\">\n                                Lens is focus-ready.\n                            </p>\n                            <p class=\"text-[11px] text-[var(--ink-soft)] leading-relaxed\" data-kid=\"2-2-3-1-2-1-2-2\" data-name=\"placeholder description\">\n                                Start an analysis to reveal blind spots, vulnerabilities, and potential optimizations.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <!-- Patterns Section -->\n            <section class=\"flex flex-col gap-4\" data-kid=\"2-2-3-2\" data-name=\"patterns section\">\n                <div class=\"flex items-center justify-between\" data-kid=\"2-2-3-2-1\" data-name=\"patterns header\">\n                    <h2 class=\"font-serif text-xl text-[var(--ink-soft)]\" data-kid=\"2-2-3-2-1-1\" data-name=\"patterns title\">\n                        Patterns\n                    </h2>\n                    <span class=\"text-[9px] font-black text-[var(--coral)] uppercase tracking-widest bg-[var(--coral)]/10 px-1.5 py-0.5 rounded-full\" data-kid=\"2-2-3-2-1-2\" data-name=\"pattern count badge\">\n                        0/3\n                    </span>\n                </div>\n                <div class=\"p-5 rounded-[var(--radius-lg)] bg-[var(--paper)] border border-[var(--line)] flex flex-col gap-3 shadow-sm\" data-kid=\"2-2-3-2-2\" data-name=\"pattern locked state card\">\n                    <div class=\"flex -space-x-2\" data-kid=\"2-2-3-2-2-1\" data-name=\"pattern avatar stack\">\n                        <div class=\"w-6 h-6 rounded-full bg-[var(--sage)]/20 border-2 border-white flex items-center justify-center\" data-kid=\"2-2-3-2-2-1-1\" data-name=\"avatar 1 container\">\n                            <div class=\"w-1 h-1 rounded-full bg-[var(--sage)]\" data-kid=\"2-2-3-2-2-1-1-1\" data-name=\"dot 1\">\n                            </div>\n                        </div>\n                        <div class=\"w-6 h-6 rounded-full bg-[var(--orange)]/20 border-2 border-white flex items-center justify-center\" data-kid=\"2-2-3-2-2-1-2\" data-name=\"avatar 2 container\">\n                            <div class=\"w-1 h-1 rounded-full bg-[var(--orange)]\" data-kid=\"2-2-3-2-2-1-2-1\" data-name=\"dot 2\">\n                            </div>\n                        </div>\n                        <div class=\"w-6 h-6 rounded-full bg-[var(--sky)]/20 border-2 border-white flex items-center justify-center\" data-kid=\"2-2-3-2-2-1-3\" data-name=\"avatar 3 container\">\n                            <div class=\"w-1 h-1 rounded-full bg-[var(--sky)]\" data-kid=\"2-2-3-2-2-1-3-1\" data-name=\"dot 3\">\n                            </div>\n                        </div>\n                    </div>\n                    <div data-kid=\"2-2-3-2-2-2\" data-name=\"locked message group\">\n                        <p class=\"text-[9px] font-black uppercase tracking-[0.15em] text-[var(--ink)] mb-1\" data-kid=\"2-2-3-2-2-2-1\" data-name=\"locked status title\">\n                            Tracking Locked\n                        </p>\n                        <p class=\"text-[11px] font-medium leading-relaxed text-[var(--ink-soft)]\" data-kid=\"2-2-3-2-2-2-2\" data-name=\"locked status description\">\n                            Patterns emerge after 3 analyses. We'll track your common slip-ups and provide targeted training.\n                        </p>\n                    </div>\n                </div>\n            </section>\n            <!-- Sidebar Footer Note -->\n            <div class=\"mt-auto p-4 rounded-[var(--radius-lg)] bg-[var(--ink)] text-white/90 shadow-lg\" data-kid=\"2-2-3-3\" data-name=\"sidebar footer notice container\">\n                <p class=\"text-[10px] font-medium leading-relaxed\" data-kid=\"2-2-3-3-1\" data-name=\"pro tip message text\">\n                    <span class=\"text-[var(--gold)] font-bold\" data-kid=\"2-2-3-3-1-1\" data-name=\"pro tip badge text\">\n                        ★ PRO TIP\n                    </span>\n                    <br data-kid=\"2-2-3-3-1-2\" data-name=\"pro tip line break\"/>\n                    Link your GitHub account in settings to analyze private repositories and team orgs.\n                </p>\n            </div>\n        </aside>\n    </div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    window.addEventListener('DOMContentLoaded', () => {\n    // Reveal animations\n    gsap.from(\"header\", { y: -20, opacity: 0, duration: 1, ease: \"expo.out\" });\n    gsap.from(\"aside\", { opacity: 0, duration: 1.5, ease: \"power2.out\", stagger: 0.2 });\n    gsap.from(\".workspace-content\", { y: 30, opacity: 0, duration: 1.2, ease: \"expo.out\", delay: 0.3 });\n    \n    // Animate trace lines (standard opacity + slight motion)\n    gsap.from(\"#mainTrace\", { \n      opacity: 0,\n      x: 20,\n      duration: 2, \n      ease: \"power2.out\"\n    });\n\n    // Subtle floating animation for traces\n    gsap.to(\"#traces svg\", {\n      y: 10,\n      duration: 5,\n      repeat: -1,\n      yoyo: true,\n      ease: \"sine.inOut\"\n    });\n  });\n</script>\n",
      "comments": [],
      "created": "2026-08-02T17:20:22.896729+00:00",
      "modified": "2026-08-02T17:20:22.896729+00:00",
      "id": "var_a070684b9dd7"
    },
    "var_08a9061f0e4c": {
      "type": "variant",
      "label": "CodeLens App — Diagnosis",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 10780,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n    @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&display=swap');\n\n    :root {\n        --ink: #241C2E;\n        --ink-soft: #3a3040;\n        --paper: #ffffff;\n        --cream: #FAF7F2;\n        --line: #efece6;\n        --muted: #8a848d;\n        --coral: #FF6B4A;\n        --gold: #F4B740;\n        --lav: #CDB8F7;\n        --sage: #8FBF6B;\n        --sky: #AEDDE4;\n        --pink: #F25C9A;\n        --orange: #F2884B;\n        --ribbon: #1C1730;\n        --radius-lg: 32px;\n        --radius-md: 20px;\n        --font-serif: Georgia, \"Times New Roman\", serif;\n        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif;\n    }\n\n    .font-serif { font-family: var(--font-serif); }\n    .font-mono { font-family: 'Fira Code', monospace; }\n\n    .card-shadow {\n        box-shadow: 0 15px 40px -10px rgba(36, 28, 46, 0.06);\n    }\n\n    .diagnosis-card {\n        box-shadow: 0 40px 100px -20px rgba(255, 107, 74, 0.12), 0 20px 40px -10px rgba(36, 28, 46, 0.08);\n        z-index: 20;\n    }\n\n    /* Editor Syntax Highlighting */\n    .token-keyword { color: var(--lav); font-weight: 600; }\n    .token-function { color: var(--sky); }\n    .token-number { color: var(--orange); }\n    .token-string { color: var(--sage); }\n    .token-comment { color: rgba(255, 255, 255, 0.25); font-style: italic; }\n    .token-op { color: var(--gold); }\n\n    .ribbon-path {\n        stroke-dasharray: 4000;\n        stroke-dashoffset: 4000;\n    }\n\n    .custom-scrollbar::-webkit-scrollbar { width: 4px; }\n    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }\n    .custom-scrollbar::-webkit-scrollbar-thumb { background: var(--line); border-radius: 10px; }\n\n    .glow-dot {\n        box-shadow: 0 0 10px var(--coral);\n    }\n</style>\n\n<div class=\"min-h-screen bg-[var(--cream)] selection:bg-[var(--lav)] font-sans text-[var(--ink)] overflow-x-clip relative\">\n    \n    <!-- Decorative Ribbon -->\n    <svg class=\"fixed top-0 left-0 w-full h-full pointer-events-none z-0\" viewBox=\"0 0 1440 900\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path id=\"mainRibbon\" d=\"M-100 300C200 250 500 800 800 450C1100 100 1400 600 1700 350\" stroke=\"var(--ribbon)\" stroke-width=\"120\" stroke-linecap=\"round\" class=\"ribbon-path\" opacity=\"0.05\" />\n    </svg>\n\n    <!-- Header -->\n    <header class=\"fixed top-0 left-0 right-0 z-50 px-8 pt-8 pointer-events-none\">\n        <div class=\"max-w-[1300px] mx-auto flex items-center justify-between bg-white/70 backdrop-blur-xl px-8 py-4 rounded-[28px] border border-[var(--line)] shadow-sm pointer-events-auto\">\n            <div class=\"flex items-center gap-3\">\n                <div class=\"w-9 h-9 rounded-full border-2 border-[var(--ink)] flex items-center justify-center\">\n                    <div class=\"w-4 h-4 bg-[var(--coral)]\" style=\"clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);\"></div>\n                </div>\n                <span class=\"font-extrabold text-xl tracking-tight text-[var(--ink)]\">CodeLens</span>\n            </div>\n\n            <nav class=\"hidden md:flex items-center gap-10\">\n                <a href=\"#\" class=\"text-[10px] font-black tracking-widest text-[var(--ink)] uppercase border-b-2 border-[var(--ink)] pb-1\">Workspace</a>\n                <a href=\"#\" class=\"text-[10px] font-black tracking-widest text-[var(--muted)] uppercase hover:text-[var(--ink)] transition-colors pb-1\">Patterns</a>\n                <a href=\"#\" class=\"text-[10px] font-black tracking-widest text-[var(--muted)] uppercase hover:text-[var(--ink)] transition-colors pb-1\">Drills</a>\n            </nav>\n\n            <div class=\"flex items-center gap-5\">\n                <div class=\"flex items-center gap-3 pr-5 border-r border-[var(--line)]\">\n                    <div class=\"text-right\">\n                        <p class=\"text-[12px] font-extrabold leading-none mb-0.5\">Maya Chen</p>\n                        <p class=\"text-[9px] font-bold text-[var(--muted)] uppercase tracking-wider\">Full-stack</p>\n                    </div>\n                    <img src=\"https://i.pravatar.cc/100?u=maya\" alt=\"Maya Chen\" class=\"w-9 h-9 rounded-full border border-[var(--line)]\" decoding=\"async\" loading=\"lazy\" />\n                </div>\n                <button class=\"text-[9px] font-black tracking-widest text-[var(--muted)] hover:text-[var(--ink)] transition-colors uppercase\">Sign Out</button>\n            </div>\n        </div>\n    </header>\n\n    <!-- App Content -->\n    <div class=\"pt-32 pb-12 px-8 max-w-[1400px] mx-auto min-h-screen flex gap-8 relative z-10\">\n        \n        <!-- Peripheral Left: History -->\n        <aside class=\"w-[220px] shrink-0 flex flex-col gap-6 stagger-item\">\n            <div class=\"bg-white/40 p-6 rounded-[var(--radius-lg)] border border-[var(--line)] flex flex-col h-full overflow-hidden\">\n                <div class=\"flex items-center justify-between mb-6\">\n                    <h2 class=\"font-serif text-xl font-bold\">History</h2>\n                    <button class=\"text-[9px] font-black tracking-wider text-[var(--muted)] uppercase hover:text-[var(--coral)]\">Clear</button>\n                </div>\n                <div class=\"flex-1 overflow-y-auto custom-scrollbar space-y-3 pr-1\">\n                    <div class=\"p-3 bg-white rounded-xl border border-[var(--line)] card-shadow cursor-pointer border-l-4 border-l-[var(--coral)]\">\n                        <span class=\"text-[8px] font-bold text-[var(--muted)] uppercase tracking-wider block mb-1\">Now</span>\n                        <h4 class=\"text-[11px] font-bold text-[var(--ink)]\">find_duplicates.js</h4>\n                    </div>\n                    <div class=\"p-3 bg-transparent hover:bg-white/20 rounded-xl transition-colors opacity-60\">\n                        <span class=\"text-[8px] font-bold text-[var(--muted)] uppercase tracking-wider block mb-1\">1h ago</span>\n                        <h4 class=\"text-[11px] font-bold text-[var(--ink)]\">auth_provider.py</h4>\n                    </div>\n                    <div class=\"p-3 bg-transparent hover:bg-white/20 rounded-xl transition-colors opacity-50\">\n                        <span class=\"text-[8px] font-bold text-[var(--muted)] uppercase tracking-wider block mb-1\">3h ago</span>\n                        <h4 class=\"text-[11px] font-bold text-[var(--ink)]\">api_gateway.go</h4>\n                    </div>\n                </div>\n                <div class=\"mt-6 p-5 bg-[var(--ink)] rounded-2xl text-white\">\n                    <p class=\"text-[9px] font-bold uppercase tracking-widest text-[var(--lav)] mb-2\">Pro Access</p>\n                    <button class=\"w-full py-2 bg-white/10 text-[9px] font-black uppercase tracking-widest rounded hover:bg-white/20 transition-colors\">Upgrade</button>\n                </div>\n            </div>\n        </aside>\n\n        <!-- Main Focal Area: Editor & Diagnosis -->\n        <main class=\"flex-1 flex flex-col gap-8 stagger-item min-w-0\">\n            \n            <!-- Editor integrated with Analysis -->\n            <div class=\"bg-white rounded-[40px] border border-[var(--line)] card-shadow overflow-hidden flex flex-col\">\n                <!-- Editor Top Bar -->\n                <div class=\"px-8 py-5 border-b border-[var(--line)] flex items-center justify-between bg-white\">\n                    <div class=\"flex items-center gap-6\">\n                        <div class=\"flex items-center gap-3\">\n                            <span class=\"text-[9px] font-black text-[var(--muted)] uppercase tracking-[0.2em]\">Source</span>\n                            <div class=\"px-4 py-2 bg-[var(--cream)] rounded-full text-[11px] font-bold border border-[var(--line)]\">maya/repo-v1/.../find_duplicates.js</div>\n                        </div>\n                        <div class=\"h-4 w-[1px] bg-[var(--line)]\"></div>\n                        <div class=\"flex bg-[var(--cream)] p-1 rounded-full border border-[var(--line)]\">\n                            <button class=\"px-6 py-1.5 bg-[var(--ink)] text-white text-[9px] font-black uppercase tracking-widest rounded-full\">Algo Scan</button>\n                            <button class=\"px-6 py-1.5 text-[var(--muted)] text-[9px] font-black uppercase tracking-widest rounded-full\">Security</button>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center gap-2\">\n                        <span class=\"text-[9px] font-black text-[var(--sage)] uppercase tracking-widest\">Active session</span>\n                        <div class=\"w-1.5 h-1.5 rounded-full bg-[var(--sage)] glow-dot\"></div>\n                    </div>\n                </div>\n\n                <!-- Code Section -->\n                <div class=\"flex-1 bg-[var(--ink)] p-4 flex flex-col group\">\n                    <div class=\"flex-1 bg-[var(--ink-soft)]/20 rounded-[24px] p-6 font-mono text-[13px] leading-relaxed relative overflow-hidden\">\n                        <div class=\"absolute top-6 left-6 flex gap-1.5\">\n                            <div class=\"w-2.5 h-2.5 rounded-full bg-[var(--coral)]/50\"></div>\n                            <div class=\"w-2.5 h-2.5 rounded-full bg-[var(--gold)]/50\"></div>\n                            <div class=\"w-2.5 h-2.5 rounded-full bg-[var(--sage)]/50\"></div>\n                        </div>\n                        \n                        <div class=\"mt-8 text-white/90\">\n<pre><code><span class=\"token-keyword\">function</span> <span class=\"token-function\">findDuplicates</span><span class=\"token-op\">(</span>arr<span class=\"token-op\">)</span> <span class=\"token-op\">{</span>\n  <span class=\"token-comment\">// Bottleneck: Nested loop creates O(n²) complexity</span>\n  <span class=\"token-keyword\">for</span> <span class=\"token-op\">(</span><span class=\"token-keyword\">let</span> i = <span class=\"token-number\">0</span>; i &lt; arr.length; i++<span class=\"token-op\">)</span> <span class=\"token-op\">{</span>\n    <span class=\"token-keyword\">for</span> <span class=\"token-op\">(</span><span class=\"token-keyword\">let</span> j = <span class=\"token-number\">0</span>; j &lt; arr.length; j++<span class=\"token-op\">)</span> <span class=\"token-op\">{</span>\n      <span class=\"token-keyword\">if</span> <span class=\"token-op\">(</span>i <span class=\"token-op\">!</span><span class=\"token-op\">==</span> j <span class=\"token-op\">&amp;&amp;</span> arr<span class=\"token-op\">[</span>i<span class=\"token-op\">]</span> <span class=\"token-op\">===</span> arr<span class=\"token-op\">[</span>j<span class=\"token-op\">]</span><span class=\"token-op\">)</span> <span class=\"token-op\">{</span>\n        <span class=\"token-keyword\">return true</span>;\n      <span class=\"token-op\">}</span>\n    <span class=\"token-op\">}</span>\n  <span class=\"token-op\">}</span>\n  <span class=\"token-keyword\">return false</span>;\n<span class=\"token-op\">}</span></code></pre>\n                        </div>\n\n                        <!-- Visual Marker for problem -->\n                        <div class=\"absolute top-28 left-0 right-0 h-[60px] bg-[var(--coral)]/5 border-y border-[var(--coral)]/20 pointer-events-none flex items-center justify-end px-12\">\n                             <div class=\"bg-[var(--coral)] text-white text-[9px] font-black uppercase px-3 py-1.5 rounded-full shadow-lg flex items-center gap-2\">\n                                 <svg class=\"w-3 h-3\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path d=\"M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z\"/></svg>\n                                 Quadratic Complexity Detected\n                             </div>\n                        </div>\n                    </div>\n                    \n                    <!-- Integrated Analyze Button -->\n                    <div class=\"p-2 flex gap-2\">\n                        <button id=\"analyzeBtn\" class=\"flex-1 h-16 bg-[var(--ink)] text-white rounded-[20px] text-[10px] font-black uppercase tracking-[0.4em] hover:bg-[var(--ink-soft)] transition-all\">Analyze Codebase</button>\n                        <button class=\"w-16 h-16 bg-white/5 text-white/50 hover:bg-white/10 flex items-center justify-center rounded-[20px] transition-colors\">\n                            <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12\"></path></svg>\n                        </button>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Diagnosis Panel (The primary visual focus) -->\n            <div class=\"flex gap-8 items-stretch\">\n                <!-- The Main Diagnosis Card -->\n                <div class=\"flex-1 bg-white p-10 rounded-[40px] border border-[var(--line)] diagnosis-card relative overflow-hidden flex flex-col gap-8\">\n                    <div class=\"absolute top-0 right-0 w-32 h-32 bg-[var(--coral)]/5 rounded-bl-[100px]\"></div>\n                    \n                    <div class=\"flex items-center justify-between relative z-10\">\n                        <div class=\"flex items-center gap-3\">\n                            <span class=\"w-2.5 h-2.5 rounded-full bg-[var(--coral)] glow-dot\"></span>\n                            <span class=\"text-[10px] font-black tracking-widest text-[var(--muted)] uppercase\">Primary Analysis</span>\n                        </div>\n                        <span class=\"px-4 py-1.5 bg-[var(--coral)] text-white text-[9px] font-black rounded-full uppercase tracking-widest shadow-xl shadow-[var(--coral)]/20\">Critical severity</span>\n                    </div>\n\n                    <div class=\"space-y-4 relative z-10\">\n                        <h2 class=\"font-serif text-[44px] font-bold leading-[1] text-[var(--ink)] max-w-lg\">Nested loops hide in plain sight</h2>\n                        <p class=\"text-[15px] text-[var(--muted)] leading-relaxed font-medium\">This pattern is responsible for 80% of your performance bottlenecks this week.</p>\n                    </div>\n\n                    <div class=\"grid grid-cols-2 gap-10 relative z-10\">\n                        <div class=\"space-y-4\">\n                            <h4 class=\"text-[9px] font-black text-[var(--ink)] uppercase tracking-[0.2em] opacity-40\">Impact Analysis</h4>\n                            <p class=\"text-[13px] leading-relaxed font-medium\">Each new element in your array creates <span class=\"text-[var(--coral)] font-bold\">n^2 operations</span>. At 10,000 items, this is 100M checks vs 10k.</p>\n                        </div>\n                        <div class=\"space-y-4\">\n                            <h4 class=\"text-[9px] font-black text-[var(--ink)] uppercase tracking-[0.2em] opacity-40\">Optimization Strategy</h4>\n                            <div class=\"bg-[var(--cream)] p-5 rounded-2xl border border-[var(--line)] font-mono text-[10px] leading-relaxed\">\n                                <div class=\"text-[var(--coral)] line-through opacity-70 mb-2\">for(let i=0;...){ for(let j=0;...){...}}</div>\n                                <div class=\"text-[var(--sage)] font-bold\">const seen = new Set(); for(const x of arr){...}</div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"mt-4 pt-8 border-t border-[var(--line)] flex items-center justify-between\">\n                        <a href=\"#\" class=\"group flex items-center gap-4\">\n                            <div class=\"w-12 h-12 bg-[var(--ink)] rounded-full flex items-center justify-center transform group-hover:scale-110 transition-transform\">\n                                <svg class=\"w-5 h-5 text-white\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z\"/><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"/></svg>\n                            </div>\n                            <div>\n                                <span class=\"text-[10px] font-black uppercase tracking-widest text-[var(--ink)] block\">Drill Practice</span>\n                                <span class=\"text-xs font-bold text-[var(--muted)] group-hover:text-[var(--coral)] transition-colors\">Apply Set-based lookup pattern</span>\n                            </div>\n                        </a>\n                        <button class=\"px-8 py-3 bg-[var(--ink)] text-white text-[10px] font-black uppercase tracking-widest rounded-full hover:bg-[var(--coral)] transition-all\">Mark as Resolved</button>\n                    </div>\n                </div>\n\n                <!-- Subtle Insight Sidebar -->\n                <div class=\"w-[280px] flex flex-col gap-6\">\n                    <div class=\"bg-white/40 p-8 rounded-[40px] border border-[var(--line)] flex flex-col gap-6 flex-1\">\n                        <div class=\"space-y-2\">\n                            <span class=\"text-[9px] font-black tracking-widest text-[var(--muted)] uppercase block\">Growth Tracker</span>\n                            <h3 class=\"font-serif text-xl font-bold leading-tight\">Clarity vs. Cleverness</h3>\n                        </div>\n                        \n                        <!-- Simple trendline instead of Slop -->\n                        <div class=\"h-20 flex items-center justify-center px-2\">\n                            <svg class=\"w-full h-full\" viewBox=\"0 0 200 60\" preserveAspectRatio=\"none\">\n                                <path d=\"M0 50 Q 50 45, 100 20 T 200 10\" fill=\"none\" stroke=\"var(--sky)\" stroke-width=\"4\" stroke-linecap=\"round\" />\n                                <circle cx=\"200\" cy=\"10\" r=\"4\" fill=\"var(--sky)\" />\n                                <path d=\"M0 60 L 0 50 Q 50 45, 100 20 T 200 10 L 200 60 Z\" fill=\"url(#grad)\" opacity=\"0.1\" />\n                                <defs>\n                                    <linearGradient id=\"grad\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n                                        <stop offset=\"0%\" style=\"stop-color:var(--sky);stop-opacity:1\" />\n                                        <stop offset=\"100%\" style=\"stop-color:var(--sky);stop-opacity:0\" />\n                                    </linearGradient>\n                                </defs>\n                            </svg>\n                        </div>\n                        \n                        <div class=\"space-y-4 mt-auto\">\n                            <div class=\"flex items-center justify-between text-[11px] font-bold border-b border-[var(--line)] pb-2\">\n                                <span class=\"text-[var(--muted)]\">Analyses</span>\n                                <span>3</span>\n                            </div>\n                            <div class=\"flex items-center justify-between text-[11px] font-bold border-b border-[var(--line)] pb-2\">\n                                <span class=\"text-[var(--muted)]\">Weak Pattern</span>\n                                <span class=\"text-[var(--coral)]\">Nested Loops</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </main>\n    </div>\n\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n            // Ribbon entrance\n            gsap.to(\"#mainRibbon\", {\n                strokeDashoffset: 0,\n                duration: 3,\n                ease: \"power2.inOut\"\n            });\n\n            // Smooth entrance of main containers\n            gsap.from(\".stagger-item\", {\n                opacity: 0,\n                y: 30,\n                duration: 1.5,\n                stagger: 0.15,\n                ease: \"expo.out\",\n                delay: 0.2\n            });\n\n            // Specific entrance for the diagnosis focal point\n            gsap.from(\".diagnosis-card\", {\n                scale: 0.98,\n                opacity: 0,\n                duration: 1.8,\n                ease: \"elastic.out(1, 0.8)\",\n                delay: 0.6\n            });\n\n            const analyzeBtn = document.getElementById('analyzeBtn');\n            if(analyzeBtn) {\n                analyzeBtn.addEventListener('mousedown', () => gsap.to(analyzeBtn, { scale: 0.98, duration: 0.1 }));\n                analyzeBtn.addEventListener('mouseup', () => gsap.to(analyzeBtn, { scale: 1, duration: 0.4, ease: \"elastic.out(1, 0.3)\" }));\n            }\n        });\n    </script>\n</div>\n",
      "comments": [],
      "created": "2026-08-02T17:20:22.931635+00:00",
      "modified": "2026-08-02T17:20:22.931635+00:00",
      "id": "var_08a9061f0e4c",
      "overrides": {
        "htmlAttrs": " lang=\"en\"",
        "bodyAttrs": " class=\"bg-[var(--cream)] selection:bg-[var(--lav)]\"",
        "head": "<meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\"></script>"
      }
    },
    "var_3c82ed300709": {
      "type": "variant",
      "label": "CodeLens App — Loading",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 12320,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&display=swap');\n  @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n  :root {\n    --ink: #241C2E;\n    --ink-soft: #3a3040;\n    --paper: #ffffff;\n    --cream: #FAF7F2;\n    --line: #e7e2da;\n    --muted: #6f6a72;\n    --coral: #FF6B4A;\n    --lav: #CDB8F7;\n    --lav-ink: #3d2c63;\n    --sage: #8FBF6B;\n    --sky: #AEDDE4;\n    --ribbon: #1C1730;\n    --radius-lg: 32px;\n    --radius-md: 20px;\n    --font-serif: 'Georgia', serif;\n  }\n\n  body {\n    margin: 0;\n    font-family: 'Inter', sans-serif;\n    background-color: var(--cream);\n    color: var(--ink);\n    min-height: 100vh;\n    overflow-x: clip;\n    display: block;\n  }\n\n  /* ============ ROBUST GRID SYSTEM (No Tailwind dependency) ============ */\n  .app-container {\n    display: grid;\n    grid-template-columns: 280px 1fr 380px;\n    grid-template-rows: 80px 1fr;\n    height: 100vh;\n    gap: 24px;\n    padding: 24px;\n    position: relative;\n    z-index: 10;\n    box-sizing: border-box;\n  }\n\n  .app-container * { box-sizing: border-box; }\n\n  .app-header {\n    grid-column: 1 / -1;\n    grid-row: 1;\n    background: var(--paper);\n    border-radius: var(--radius-lg);\n    border: 1px solid var(--line);\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 0 32px;\n    box-shadow: 0 4px 20px rgba(0,0,0,0.02);\n  }\n\n  .sidebar {\n    grid-column: 1;\n    grid-row: 2;\n    background: var(--paper);\n    border-radius: var(--radius-lg);\n    border: 1px solid var(--line);\n    display: flex;\n    flex-direction: column;\n    padding: 32px 24px;\n    overflow-y: auto;\n  }\n\n  .main-canvas {\n    grid-column: 2;\n    grid-row: 2;\n    background: var(--paper);\n    border-radius: var(--radius-lg);\n    border: 1px solid var(--line);\n    display: flex;\n    flex-direction: column;\n    padding: 40px;\n    overflow-y: auto;\n  }\n\n  .right-panel {\n    grid-column: 3;\n    grid-row: 2;\n    display: flex;\n    flex-direction: column;\n    gap: 24px;\n    overflow-y: auto;\n  }\n\n  /* ============ UI ELEMENTS ============ */\n  .font-serif { font-family: var(--font-serif); }\n  .code-font { font-family: 'Fira Code', monospace; }\n\n  .btn-primary {\n    background: var(--ink);\n    color: white;\n    border-radius: 999px;\n    height: 56px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-weight: 700;\n    font-size: 14px;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    border: none;\n    width: 100%;\n    cursor: not-allowed;\n    opacity: 0.5;\n  }\n\n  .code-editor {\n    background: var(--ink);\n    border-radius: var(--radius-md);\n    flex: 1;\n    padding: 32px;\n    position: relative;\n    overflow: hidden;\n    color: #a89bb9;\n  }\n\n  .ribbon-bg {\n    position: fixed;\n    inset: 0;\n    pointer-events: none;\n    z-index: 1;\n  }\n\n  .ribbon-path {\n    fill: none;\n    stroke: var(--ribbon);\n    stroke-width: 50;\n    stroke-linecap: round;\n    opacity: 0.1;\n    stroke-dasharray: 2000;\n    stroke-dashoffset: 2000;\n  }\n\n  .skeleton-line {\n    height: 12px;\n    background: var(--cream);\n    border-radius: 6px;\n    position: relative;\n    overflow: hidden;\n  }\n\n  .skeleton-line::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);\n    transform: translateX(-100%);\n    animation: shimmer 2s infinite;\n  }\n\n  @keyframes shimmer { 100% { transform: translateX(100%); } }\n  @keyframes pulse {\n    0%, 100% { transform: scale(0.8); opacity: 0.5; }\n    50% { transform: scale(1.2); opacity: 1; }\n  }\n</style>\n<script src=\"https://cdn.tailwindcss.com\">\n</script>\n<!-- Ribbon Background -->\n<div class=\"ribbon-bg\" data-kid=\"1\" data-name=\"ribbon background container\">\n    <svg data-dynamic=\"true\" data-kid=\"1-1\" data-name=\"ribbon svg path\" data-reason=\"stroke-dashoffset animated by GSAP on load\" height=\"100%\" preserveaspectratio=\"none\" viewbox=\"0 0 1440 900\" width=\"100%\">\n        <path class=\"ribbon-path\" d=\"M1440,0 C1200,200 1300,400 1000,500 C700,600 800,800 500,850 C200,900 100,700 -50,950\" id=\"master-ribbon\">\n        </path>\n    </svg>\n</div>\n<div class=\"app-container\" data-kid=\"2\" data-name=\"app layout grid container\">\n    <!-- Header -->\n    <header class=\"app-header\" data-kid=\"2-1\" data-name=\"app header bar\">\n        <div class=\"flex items-center gap-4\" data-kid=\"2-1-1\" data-name=\"logo and branding group\">\n            <div class=\"w-10 h-10 rounded-full border-2 border-[var(--ink)] flex items-center justify-center bg-[var(--lav)]\" data-kid=\"2-1-1-1\" data-name=\"app logo icon container\">\n                <svg class=\"w-6 h-6 text-[var(--lav-ink)]\" data-kid=\"2-1-1-1-1\" data-name=\"lens icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                    <path d=\"M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3\">\n                    </path>\n                </svg>\n            </div>\n            <h1 class=\"font-serif text-2xl font-bold tracking-tight\" data-kid=\"2-1-1-2\" data-name=\"app title text\">\n                CodeLens\n            </h1>\n        </div>\n        <div class=\"flex items-center gap-6\" data-kid=\"2-1-2\" data-name=\"user profile and action area\">\n            <div class=\"h-8 w-[1px] bg-[var(--line)]\" data-kid=\"2-1-2-1\" data-name=\"vertical separator line\">\n            </div>\n            <div class=\"flex items-center gap-4\" data-kid=\"2-1-2-2\" data-name=\"user account information container\">\n                <div class=\"text-right\" data-kid=\"2-1-2-2-1\" data-name=\"user identity and actions container\">\n                    <div class=\"text-sm font-bold\" data-kid=\"2-1-2-2-1-1\" data-name=\"user name label\">\n                        Maya Chen\n                    </div>\n                    <button class=\"text-[10px] font-bold tracking-widest uppercase text-[var(--muted)] hover:text-[var(--ink)] cursor-pointer\" data-kid=\"2-1-2-2-1-2\" data-name=\"sign out button\">\n                        Sign out\n                    </button>\n                </div>\n                <img alt=\"Maya Chen\" class=\"w-11 h-11 rounded-full border-2 border-[var(--cream)] shadow-md\" data-kid=\"2-1-2-2-2\" data-name=\"user avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/100?u=maya\"/>\n            </div>\n        </div>\n    </header>\n    <!-- Sidebar -->\n    <aside class=\"sidebar panel-item\" data-kid=\"2-2\" data-name=\"recent analysis sidebar\">\n        <h3 class=\"font-serif text-xl font-bold mb-6\" data-kid=\"2-2-1\" data-name=\"sidebar heading\">\n            Recent Analysis\n        </h3>\n        <div class=\"flex flex-col gap-3\" data-kid=\"2-2-2\" data-name=\"recent analysis history list\">\n            <div class=\"p-4 rounded-[var(--radius-md)] border border-[var(--line)] bg-[var(--cream)] opacity-70 flex flex-col gap-2 cursor-pointer hover:opacity-100 transition-opacity\" data-kid=\"2-2-2-1\" data-name=\"first recent analysis item\">\n                <div class=\"flex justify-between items-center\" data-kid=\"2-2-2-1-1\" data-name=\"item timestamp and status container\">\n                    <span class=\"text-[10px] font-bold uppercase tracking-widest text-[var(--muted)]\" data-kid=\"2-2-2-1-1-1\" data-name=\"item timestamp text\">\n                        2h ago\n                    </span>\n                    <div class=\"w-2 h-2 rounded-full bg-[var(--sage)]\" data-kid=\"2-2-2-1-1-2\" data-name=\"item status indicator\">\n                    </div>\n                </div>\n                <span class=\"text-sm font-bold truncate\" data-kid=\"2-2-2-1-2\" data-name=\"item filename text\">\n                    auth_controller.py\n                </span>\n            </div>\n            <div class=\"p-4 rounded-[var(--radius-md)] border border-[var(--line)] bg-[var(--cream)] opacity-70 flex flex-col gap-2 cursor-pointer hover:opacity-100 transition-opacity\" data-kid=\"2-2-2-2\" data-name=\"second recent analysis item\">\n                <div class=\"flex justify-between items-center\" data-kid=\"2-2-2-2-1\" data-name=\"item timestamp and status container\">\n                    <span class=\"text-[10px] font-bold uppercase tracking-widest text-[var(--muted)]\" data-kid=\"2-2-2-2-1-1\" data-name=\"item timestamp text\">\n                        Yesterday\n                    </span>\n                    <div class=\"w-2 h-2 rounded-full bg-[var(--coral)]\" data-kid=\"2-2-2-2-1-2\" data-name=\"item status indicator\">\n                    </div>\n                </div>\n                <span class=\"text-sm font-bold truncate\" data-kid=\"2-2-2-2-2\" data-name=\"item filename text\">\n                    payment_gateway_v2.ts\n                </span>\n            </div>\n        </div>\n        <div class=\"mt-auto pt-8\" data-kid=\"2-2-3\" data-name=\"sidebar upgrade section container\">\n            <div class=\"bg-[var(--ink)] rounded-[var(--radius-md)] p-6 text-white relative overflow-hidden\" data-kid=\"2-2-3-1\" data-name=\"upgrade promo card\">\n                <h4 class=\"font-serif text-lg font-bold mb-2\" data-kid=\"2-2-3-1-1\" data-name=\"upgrade heading\">\n                    Upgrade\n                </h4>\n                <p class=\"text-[10px] opacity-70 mb-4\" data-kid=\"2-2-3-1-2\" data-name=\"upgrade description text\">\n                    Unlock pattern history.\n                </p>\n                <button class=\"w-full h-10 bg-white text-[var(--ink)] rounded-full text-[10px] font-bold uppercase\" data-kid=\"2-2-3-1-3\" data-name=\"upgrade action button\">\n                    Go Pro\n                </button>\n            </div>\n        </div>\n    </aside>\n    <!-- Main Canvas -->\n    <main class=\"main-canvas panel-item\" data-kid=\"2-3\" data-name=\"main code canvas section\">\n        <div class=\"flex items-end gap-6 mb-8\" data-kid=\"2-3-1\" data-name=\"repository input header\">\n            <div class=\"flex-1\" data-kid=\"2-3-1-1\" data-name=\"url input field container\">\n                <label class=\"block text-[10px] font-bold uppercase tracking-widest text-[var(--muted)] mb-3\" data-kid=\"2-3-1-1-1\" data-name=\"input label\">\n                    GitHub Repository URL\n                </label>\n                <div class=\"relative\" data-kid=\"2-3-1-1-2\" data-name=\"url input wrapper\">\n                    <input class=\"w-full bg-[var(--cream)] border border-[var(--line)] rounded-full h-12 px-6 text-sm font-medium outline-none text-[var(--muted)]\" data-kid=\"2-3-1-1-2-1\" data-name=\"github repository url input\" readonly=\"\" type=\"text\" value=\"https://github.com/maya-dev/secure-api-core\"/>\n                </div>\n            </div>\n            <div class=\"bg-[var(--cream)] p-1 rounded-full border border-[var(--line)] flex gap-1\" data-kid=\"2-3-1-2\" data-name=\"view mode selector button group\">\n                <button class=\"h-10 px-6 rounded-full text-[10px] font-bold bg-white shadow-sm\" data-kid=\"2-3-1-2-1\" data-name=\"algo view button\">\n                    ALGO\n                </button>\n                <button class=\"h-10 px-6 rounded-full text-[10px] font-bold text-[var(--muted)]\" data-kid=\"2-3-1-2-2\" data-name=\"security view button\">\n                    SECURITY\n                </button>\n            </div>\n        </div>\n        <div class=\"code-editor\" data-kid=\"2-3-2\" data-name=\"code display editor area\">\n            <!-- Floating Analysis Overlay -->\n            <div class=\"absolute inset-0 bg-[#241C2E]/70 backdrop-blur-sm flex items-center justify-center z-20\" data-kid=\"2-3-2-1\" data-name=\"analysis overlay loading screen\">\n                <div class=\"bg-white/10 border border-white/20 p-6 rounded-2xl flex items-center gap-4 shadow-2xl\" data-kid=\"2-3-2-1-1\" data-name=\"loading modal content\">\n                    <div class=\"relative w-8 h-8 flex-shrink-0\" data-kid=\"2-3-2-1-1-1\" data-name=\"spinner container\">\n                        <div class=\"absolute inset-0 border-2 border-white/10 rounded-full\" data-kid=\"2-3-2-1-1-1-1\" data-name=\"spinner background circle\">\n                        </div>\n                        <div class=\"absolute inset-0 border-2 border-[#CDB8F7] border-t-transparent rounded-full animate-spin\" data-kid=\"2-3-2-1-1-1-2\" data-name=\"spinner foreground arc\">\n                        </div>\n                    </div>\n                    <div class=\"flex flex-col\" data-kid=\"2-3-2-1-1-2\" data-name=\"loading message container\">\n                        <span class=\"text-white text-sm font-bold tracking-wide\" data-kid=\"2-3-2-1-1-2-1\" data-name=\"loading title text\">\n                            Mapping Syntax Tree\n                        </span>\n                        <span class=\"text-white/60 text-[10px] font-medium\" data-kid=\"2-3-2-1-1-2-2\" data-name=\"loading status text\">\n                            Scanning for variable declarations...\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"code-font text-sm leading-relaxed whitespace-pre opacity-30\" data-kid=\"2-3-2-2\" data-name=\"syntax highlighted code block\">\n                <span class=\"text-[#c678dd]\" data-kid=\"2-3-2-2-1\" data-name=\"import keyword\">\n                    import\n                </span>\n                jwt\n                <span class=\"text-[#c678dd]\" data-kid=\"2-3-2-2-2\" data-name=\"from keyword\">\n                    from\n                </span>\n                datetime\n                <span class=\"text-[#c678dd]\" data-kid=\"2-3-2-2-3\" data-name=\"import keyword\">\n                    import\n                </span>\n                datetime, timedelta\n                <span class=\"text-[#c678dd]\" data-kid=\"2-3-2-2-4\" data-name=\"class keyword\">\n                    class\n                </span>\n                <span class=\"text-[#e5c07b]\" data-kid=\"2-3-2-2-5\" data-name=\"class name text\">\n                    AuthManager\n                </span>\n                :\n                <span class=\"text-[#c678dd]\" data-kid=\"2-3-2-2-6\" data-name=\"def keyword\">\n                    def\n                </span>\n                <span class=\"text-[#61afef]\" data-kid=\"2-3-2-2-7\" data-name=\"method name text\">\n                    __init__\n                </span>\n                (\n                <span class=\"text-[#d19a66]\" data-kid=\"2-3-2-2-8\" data-name=\"self keyword\">\n                    self\n                </span>\n                , secret_key):\n                <span class=\"text-[#d19a66]\" data-kid=\"2-3-2-2-9\" data-name=\"self keyword\">\n                    self\n                </span>\n                .secret_key = secret_key\n            </div>\n        </div>\n        <div class=\"mt-8\" data-kid=\"2-3-3\" data-name=\"analysis trigger footer container\">\n            <button class=\"btn-primary gap-3\" data-kid=\"2-3-3-1\" data-name=\"analysis action button\">\n                <svg class=\"w-5 h-5 animate-spin\" data-kid=\"2-3-3-1-1\" data-name=\"loading spinner icon\" viewbox=\"0 0 24 24\">\n                    <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" fill=\"none\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\">\n                    </circle>\n                    <path class=\"opacity-75\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\" fill=\"currentColor\">\n                    </path>\n                </svg>\n                Analyzing...\n            </button>\n        </div>\n    </main>\n    <!-- Right Panel -->\n    <aside class=\"right-panel\" data-kid=\"2-4\" data-name=\"analysis progress panel\">\n        <div class=\"bg-white border border-[var(--line)] rounded-[var(--radius-lg)] p-10 shadow-xl panel-item\" data-kid=\"2-4-1\" data-name=\"analysis status card\">\n            <h2 class=\"font-serif text-3xl font-bold mb-10 leading-tight\" data-kid=\"2-4-1-1\" data-name=\"analysis heading\">\n                Reading your code\n            </h2>\n            <div class=\"space-y-10 relative\" data-kid=\"2-4-1-2\" data-name=\"progress steps list\">\n                <!-- Progress Steps -->\n                <div class=\"flex gap-6 relative\" data-kid=\"2-4-1-2-1\" data-name=\"completed progress step\">\n                    <div class=\"w-6 h-6 rounded-full bg-[var(--coral)] flex-shrink-0 flex items-center justify-center relative z-10\" data-kid=\"2-4-1-2-1-1\" data-name=\"step status icon\">\n                        <svg class=\"w-3.5 h-3.5 text-white\" data-kid=\"2-4-1-2-1-1-1\" data-name=\"checkmark icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"4\" viewbox=\"0 0 24 24\">\n                            <path d=\"M5 13l4 4L19 7\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            </path>\n                        </svg>\n                    </div>\n                    <div class=\"flex flex-col gap-1\" data-kid=\"2-4-1-2-1-2\" data-name=\"step label and detail container\">\n                        <h4 class=\"text-sm font-bold\" data-kid=\"2-4-1-2-1-2-1\" data-name=\"step title\">\n                            Parse structure\n                        </h4>\n                        <p class=\"text-xs text-[var(--muted)]\" data-kid=\"2-4-1-2-1-2-2\" data-name=\"step description\">\n                            Abstract syntax tree generated\n                        </p>\n                    </div>\n                    <div class=\"absolute left-3 top-6 bottom-[-40px] w-[2px] bg-[var(--coral)]\" data-kid=\"2-4-1-2-1-3\" data-name=\"step connector line\">\n                    </div>\n                </div>\n                <div class=\"flex gap-6 relative\" data-kid=\"2-4-1-2-2\" data-name=\"active progress step\">\n                    <div class=\"w-6 h-6 rounded-full bg-white border-2 border-[var(--coral)] flex-shrink-0 flex items-center justify-center relative z-10\" data-kid=\"2-4-1-2-2-1\" data-name=\"step status icon\">\n                        <div class=\"w-2 h-2 rounded-full bg-[var(--coral)]\" data-kid=\"2-4-1-2-2-1-1\" data-name=\"pulsing active status indicator\" style=\"animation: pulse 1.5s infinite\">\n                        </div>\n                    </div>\n                    <div class=\"flex flex-col gap-1\" data-kid=\"2-4-1-2-2-2\" data-name=\"step label and detail container\">\n                        <h4 class=\"text-sm font-bold\" data-kid=\"2-4-1-2-2-2-1\" data-name=\"step title\">\n                            Check complexity\n                        </h4>\n                        <p class=\"text-xs text-[var(--muted)]\" data-kid=\"2-4-1-2-2-2-2\" data-name=\"step description\">\n                            Calculating cyclomatic paths...\n                        </p>\n                        <div class=\"mt-4 w-48 h-1.5 bg-[var(--cream)] rounded-full overflow-hidden\" data-kid=\"2-4-1-2-2-2-3\" data-name=\"progress bar track\">\n                            <div class=\"h-full bg-[var(--coral)] w-[45%]\" data-dynamic=\"true\" data-kid=\"2-4-1-2-2-2-3-1\" data-name=\"progress bar fill\" data-reason=\"width animated by GSAP continuously\" id=\"complexity-progress\">\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"absolute left-3 top-6 bottom-[-40px] w-[2px] bg-[var(--line)]\" data-kid=\"2-4-1-2-2-3\" data-name=\"step connector line\">\n                    </div>\n                </div>\n                <div class=\"flex gap-6 opacity-40\" data-kid=\"2-4-1-2-3\" data-name=\"upcoming progress step\">\n                    <div class=\"w-6 h-6 rounded-full bg-white border-2 border-[var(--line)] flex-shrink-0 relative z-10\" data-kid=\"2-4-1-2-3-1\" data-name=\"step indicator\">\n                    </div>\n                    <div class=\"flex flex-col gap-1\" data-kid=\"2-4-1-2-3-2\" data-name=\"step label and detail container\">\n                        <h4 class=\"text-sm font-bold\" data-kid=\"2-4-1-2-3-2-1\" data-name=\"step title\">\n                            Compare patterns\n                        </h4>\n                        <p class=\"text-xs text-[var(--muted)]\" data-kid=\"2-4-1-2-3-2-2\" data-name=\"step description\">\n                            Matching against known anti-patterns\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <!-- Skeleton Result -->\n            <div class=\"mt-12 pt-8 border-t border-[var(--line)] space-y-4\" data-kid=\"2-4-1-3\" data-name=\"analysis result skeleton area\">\n                <div class=\"skeleton-line w-3/4\" data-kid=\"2-4-1-3-1\" data-name=\"skeleton heading line\">\n                </div>\n                <div class=\"skeleton-line w-1/2\" data-kid=\"2-4-1-3-2\" data-name=\"skeleton detail line\">\n                </div>\n                <div class=\"h-20 bg-[var(--cream)] rounded-xl w-full animate-pulse\" data-kid=\"2-4-1-3-3\" data-name=\"skeleton box\">\n                </div>\n            </div>\n        </div>\n        <div class=\"bg-[var(--lav)] p-8 rounded-[var(--radius-lg)] border border-[var(--line)] panel-item\" data-kid=\"2-4-2\" data-name=\"pattern tracking section card\">\n            <h3 class=\"font-serif text-xl font-bold text-[var(--lav-ink)] mb-2\" data-kid=\"2-4-2-1\" data-name=\"pattern tracking heading\">\n                Pattern Tracking\n            </h3>\n            <p class=\"text-xs text-[var(--lav-ink)] opacity-70 mb-6\" data-kid=\"2-4-2-2\" data-name=\"pattern tracking description\">\n                Complete 3 analyses to unlock growth map.\n            </p>\n            <div class=\"w-full h-2 bg-white/40 rounded-full overflow-hidden\" data-kid=\"2-4-2-3\" data-name=\"tracking progress bar track\">\n                <div class=\"h-full bg-[var(--lav-ink)] w-[66%]\" data-kid=\"2-4-2-3-1\" data-name=\"tracking progress bar fill\">\n                </div>\n            </div>\n        </div>\n    </aside>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script type=\"module\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n  new Lenis().raf();\n  \n  gsap.to(\".ribbon-path\", { strokeDashoffset: 0, duration: 3, ease: \"power2.out\" });\n  gsap.from(\".panel-item\", { y: 30, opacity: 0, duration: 1, stagger: 0.1, ease: \"expo.out\" });\n  gsap.to(\"#complexity-progress\", { width: \"85%\", duration: 4, repeat: -1, yoyo: true, ease: \"sine.inOut\" });\n</script>\n",
      "comments": [],
      "created": "2026-08-02T17:20:22.988589+00:00",
      "modified": "2026-08-02T17:20:22.988589+00:00",
      "id": "var_3c82ed300709"
    },
    "var_ad22f9b93370": {
      "type": "variant",
      "label": "CodeLens Onboarding — Patterns",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 13860,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "\n<div class=\"min-h-screen bg-[#FAF7F2] text-[#241C2E] font-sans overflow-x-clip selection:bg-[#FF6B4A]/30\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap');\n        \n        :root {\n            --ink: #241C2E;\n            --cream: #FAF7F2;\n            --coral: #FF6B4A;\n            --gold: #F4B740;\n            --lav: #CDB8F7;\n            --sage: #8FBF6B;\n            --sky: #AEDDE4;\n            --pink: #F25C9A;\n            --orange: #F2884B;\n        }\n\n        .font-serif { font-family: 'Georgia', serif; }\n        .font-display { font-family: 'Instrument Serif', serif; }\n\n        .btn-shadow {\n            box-shadow: 0 4px 0px rgba(36, 28, 46, 0.1);\n        }\n        \n        .card-shadow {\n            box-shadow: 0 20px 40px -10px rgba(36, 28, 46, 0.15);\n        }\n\n        .ribbon-path {\n            stroke-dasharray: 2000;\n            stroke-dashoffset: 2000;\n        }\n\n        body {\n            overscroll-behavior: none;\n        }\n    </style>\n\n    <!-- Header -->\n    <header class=\"fixed top-0 left-0 w-full px-12 py-8 flex justify-between items-center z-50\">\n        <div class=\"flex items-center gap-3\">\n            <div class=\"w-9 h-9 rounded-full border-2 border-[#241C2E] flex items-center justify-center bg-white\">\n                <div class=\"w-4.5 h-4.5 bg-[#241C2E] rounded-full flex items-center justify-center\">\n                    <div class=\"w-1 h-1 bg-white rounded-full\"></div>\n                </div>\n            </div>\n            <span class=\"font-bold text-lg tracking-tight uppercase\">CodeLens</span>\n        </div>\n        \n        <div class=\"flex items-center gap-5\">\n            <span class=\"text-[10px] font-black tracking-[0.2em] text-[#241C2E]/30 uppercase\">Progress</span>\n            <div class=\"flex gap-1.5\">\n                <div class=\"w-8 h-1 bg-[#241C2E] rounded-full\"></div>\n                <div class=\"w-8 h-1 bg-[#241C2E] rounded-full\"></div>\n                <div class=\"w-8 h-1 bg-[#241C2E]/10 rounded-full\"></div>\n            </div>\n        </div>\n    </header>\n\n    <main class=\"container mx-auto px-12 pt-32 pb-24 min-h-screen flex items-center\">\n        <div class=\"grid grid-cols-12 gap-16 items-start w-full\">\n            \n            <!-- Left Content: Copy & Timeline -->\n            <div class=\"col-span-12 lg:col-span-5 space-y-12\">\n                <div class=\"space-y-8 intro-text\">\n                    <h1 class=\"font-serif text-7xl md:text-8xl font-bold leading-[0.95] tracking-tighter\">\n                        Your blind spots have a history.\n                    </h1>\n                    <p class=\"text-xl text-[#241C2E]/60 max-w-sm leading-relaxed font-medium\">\n                        CodeLens doesn't just find bugs; it tracks recurring patterns in your logic to help you break bad habits for good.\n                    </p>\n                </div>\n\n                <!-- Pattern Timeline -->\n                <div class=\"timeline-container bg-white border border-[#241C2E]/5 rounded-[40px] p-8 space-y-8 shadow-2xl relative\">\n                    <div class=\"absolute -top-3 -right-3 px-4 py-2 bg-[#F4B740] rounded-full text-[9px] font-black tracking-[0.2em] text-[#241C2E] border-4 border-white shadow-lg z-10 uppercase\">\n                        Active Patterns\n                    </div>\n                    \n                    <div class=\"space-y-6 relative\">\n                        <!-- Connecting Line -->\n                        <div class=\"absolute left-[15px] top-2 bottom-2 w-[1px] border-l border-dashed border-[#241C2E]/20\"></div>\n\n                        <!-- Item 1 -->\n                        <div class=\"timeline-item flex gap-6 items-center\">\n                            <div class=\"w-8 h-8 rounded-full bg-[#FF6B4A] border-4 border-white shadow-md z-10\"></div>\n                            <div class=\"flex-1\">\n                                <div class=\"flex justify-between items-end\">\n                                    <h3 class=\"font-bold text-lg text-[#241C2E]\">Nested loops</h3>\n                                    <span class=\"text-[10px] font-black text-[#241C2E]/40 uppercase tracking-widest\">4 Instances</span>\n                                </div>\n                                <div class=\"mt-2 h-1 w-full bg-[#241C2E]/5 rounded-full\">\n                                    <div class=\"h-full bg-[#FF6B4A] w-4/5 rounded-full\"></div>\n                                </div>\n                            </div>\n                        </div>\n\n                        <!-- Item 2 -->\n                        <div class=\"timeline-item flex gap-6 items-center\">\n                            <div class=\"w-8 h-8 rounded-full bg-[#F4B740] border-4 border-white shadow-md z-10\"></div>\n                            <div class=\"flex-1\">\n                                <div class=\"flex justify-between items-end\">\n                                    <h3 class=\"font-bold text-lg text-[#241C2E]\">Missing validation</h3>\n                                    <span class=\"text-[10px] font-black text-[#241C2E]/40 uppercase tracking-widest\">2 Instances</span>\n                                </div>\n                                <div class=\"mt-2 h-1 w-full bg-[#241C2E]/5 rounded-full\">\n                                    <div class=\"h-full bg-[#F4B740] w-2/5 rounded-full\"></div>\n                                </div>\n                            </div>\n                        </div>\n\n                        <!-- Item 3 -->\n                        <div class=\"timeline-item flex gap-6 items-center\">\n                            <div class=\"w-8 h-8 rounded-full bg-[#CDB8F7] border-4 border-white shadow-md z-10 opacity-90\"></div>\n                            <div class=\"flex-1 opacity-90\">\n                                <div class=\"flex justify-between items-end\">\n                                    <h3 class=\"font-bold text-lg text-[#241C2E]\">Unbounded query</h3>\n                                    <span class=\"text-[10px] font-black text-[#241C2E]/40 uppercase tracking-widest\">1 Instance</span>\n                                </div>\n                                <div class=\"mt-2 h-1 w-full bg-[#241C2E]/5 rounded-full\">\n                                    <div class=\"h-full bg-[#CDB8F7] w-1/5 rounded-full\"></div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Footer Navigation (Moved from fixed position to avoid collision) -->\n                <div class=\"footer-nav flex items-center gap-6 pt-4\">\n                    <button class=\"px-8 py-4 rounded-full border-2 border-[#241C2E]/5 text-[#241C2E]/40 font-black tracking-[0.2em] text-[10px] hover:bg-[#241C2E]/5 transition-all uppercase cursor-pointer\">\n                        Back\n                    </button>\n                    <button class=\"px-12 py-4 rounded-full bg-[#241C2E] text-white font-black tracking-[0.2em] text-[10px] btn-shadow hover:translate-y-[-2px] hover:shadow-2xl transition-all uppercase group flex items-center cursor-pointer\">\n                        Next \n                        <i class=\"fas fa-chevron-right ml-3 text-[8px] group-hover:translate-x-1 transition-transform\"></i>\n                    </button>\n                </div>\n            </div>\n\n            <!-- Right Content: Editorial Visual -->\n            <div class=\"col-span-12 lg:col-span-7 relative flex items-center justify-center min-h-[600px] mt-[-40px]\">\n                \n                <!-- Ribbon SVG (Now delicate 2px-4px line) -->\n                <svg class=\"absolute inset-0 w-full h-full pointer-events-none z-0\" viewBox=\"0 0 800 800\" fill=\"none\">\n                    <path class=\"ribbon-path\" d=\"M200,100 C400,0 500,400 350,550 C200,700 700,800 750,550\" stroke=\"#241C2E\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-dasharray=\"8 8\" opacity=\"0.4\" />\n                </svg>\n\n                <!-- Editorial Tiles Collage -->\n                <div class=\"relative w-full max-w-2xl aspect-square grid grid-cols-4 grid-rows-4 gap-6\">\n                    \n                    <!-- Tile 1: Quote (Coral) -->\n                    <div class=\"visual-card col-span-2 row-span-2 bg-[#FF6B4A] rounded-[32px] p-10 flex flex-col justify-between border-4 border-white shadow-2xl transform rotate-1 z-20\">\n                        <div class=\"flex justify-between items-start\">\n                             <div class=\"w-12 h-12 rounded-full bg-white/20 flex items-center justify-center\">\n                                <svg class=\"w-6 h-6 text-white\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M3 21c3 0 7-1 7-8V5c0-1.25-.75-2-2-2H4c-1.25 0-2 .75-2 2v4c0 1.25.75 2 2 2h4M14 21c3 0 7-1 7-8V5c0-1.25-.75-2-2-2h-4c-1.25 0-2 .75-2 2v4c0 1.25.75 2 2 2h4\"/></svg>\n                             </div>\n                             <div class=\"text-[9px] font-black tracking-[0.2em] text-white/60 uppercase\">Insight</div>\n                        </div>\n                        <h4 class=\"font-serif text-4xl font-bold text-white leading-none tracking-tighter\">Patterns<br>define<br>progress.</h4>\n                    </div>\n\n                    <!-- Tile 2: Analysis Card (Lavender) -->\n                    <div class=\"visual-card col-span-2 bg-[#CDB8F7] rounded-[32px] p-8 flex flex-col border-4 border-white shadow-2xl transform rotate-6 z-30 translate-x-4 -translate-y-4\">\n                        <div class=\"flex justify-between items-center mb-6\">\n                            <div class=\"w-8 h-8 rounded-full bg-[#241C2E] flex items-center justify-center\">\n                                <div class=\"w-2 h-2 bg-white rounded-full\"></div>\n                            </div>\n                            <span class=\"text-[9px] font-black bg-[#241C2E] text-white px-3 py-1 rounded-full uppercase tracking-widest shadow-sm\">3 analyses</span>\n                        </div>\n                        <h5 class=\"font-serif text-2xl font-bold text-[#241C2E] mb-2 leading-none\">Logic Pulse</h5>\n                        <div class=\"mt-auto\">\n                            <svg viewBox=\"0 0 100 40\" class=\"w-full h-12\">\n                                <path d=\"M0,35 Q20,5 40,25 T80,5 T100,20\" stroke=\"#241C2E\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\" />\n                            </svg>\n                        </div>\n                    </div>\n\n                    <!-- Tile 3: Icon (Sky) -->\n                    <div class=\"visual-card bg-[#AEDDE4] rounded-[32px] aspect-square flex items-center justify-center border-4 border-white shadow-2xl transform -rotate-6 z-10 translate-x-8 translate-y-8\">\n                        <div class=\"w-14 h-14 rounded-2xl bg-white flex items-center justify-center shadow-lg\">\n                             <div class=\"w-6 h-6 border-4 border-[#241C2E] rounded-full\"></div>\n                        </div>\n                    </div>\n\n                    <!-- Tile 4: Empty Accent (Sage) -->\n                    <div class=\"visual-card col-span-2 row-span-2 bg-[#8FBF6B] rounded-[32px] border-4 border-white shadow-2xl transform rotate-2 z-10 overflow-hidden relative translate-y-12\">\n                        <div class=\"absolute inset-0 bg-white/10 flex items-center justify-center rotate-45 scale-150\">\n                             <div class=\"w-full h-4 bg-white/20\"></div>\n                        </div>\n                        <div class=\"absolute bottom-8 left-8\">\n                             <div class=\"text-[10px] font-black tracking-[0.3em] text-white uppercase\">Consistency</div>\n                             <div class=\"w-12 h-1 bg-white mt-2\"></div>\n                        </div>\n                    </div>\n\n                    <!-- Tile 5: Statistics (White) -->\n                    <div class=\"visual-card col-span-2 bg-white rounded-[32px] p-8 flex items-end justify-between border-4 border-[#e7e2da] shadow-2xl z-40 transform -translate-x-8 translate-y-8\">\n                        <div class=\"space-y-2\">\n                             <div class=\"text-[10px] font-black tracking-widest text-[#241C2E]/30 uppercase\">Improvement</div>\n                             <div class=\"text-5xl font-bold text-[#241C2E] tracking-tighter\">-14%</div>\n                        </div>\n                        <div class=\"w-16 h-16 rounded-full bg-[#8FBF6B] flex items-center justify-center text-white text-xl\">\n                            <i class=\"fas fa-arrow-down\"></i>\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n\n        </div>\n    </main>\n\n    <!-- Scripts -->\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\"></script>\n    <script>\n        gsap.registerPlugin(ScrollTrigger);\n\n        window.addEventListener('DOMContentLoaded', () => {\n            const tl = gsap.timeline({ defaults: { ease: \"power4.out\", duration: 1.2 } });\n\n            // Initial setup for path (no opacity:0)\n            gsap.set(\".ribbon-path\", { strokeDashoffset: 2000 });\n\n            tl.from(\".intro-text h1\", { y: 50, opacity: 0, stagger: 0.1 })\n              .from(\".intro-text p\", { y: 30, opacity: 0 }, \"-=0.8\")\n              .from(\".timeline-container\", { scale: 0.95, opacity: 0, y: 30 }, \"-=1\")\n              .from(\".timeline-item\", { x: -20, opacity: 0, stagger: 0.2 }, \"-=0.5\")\n              \n              // Ribbon drawing\n              .to(\".ribbon-path\", { strokeDashoffset: 0, duration: 2, ease: \"power2.inOut\" }, \"-=1.5\")\n              \n              // Cards popping in\n              .from(\".visual-card\", { \n                scale: 0.8, \n                opacity: 0, \n                y: 50, \n                rotation: (i) => [ -10, 10, -5, 5, 0, 15 ][i % 6],\n                stagger: 0.15,\n                duration: 1\n              }, \"-=1.8\")\n              \n              .from(\".footer-nav\", { y: 30, opacity: 0 }, \"-=1\")\n              .from(\"header\", { y: -100, opacity: 0 }, \"-=1.2\");\n        });\n    </script>\n    \n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css\">\n</div>\n",
